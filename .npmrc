engine-strict=true
prefer-workspace-packages=true
strict-peer-dependencies=true
auto-install-peers=false
confirm-modules-purge=false

# Équivalent npm de `minimumReleaseAge` de pnpm-workspace.yaml, pour les outils
# qui lisent .npmrc et pas la configuration d'espace de travail. npm l'exprime
# en JOURS, pnpm en MINUTES : 1 jour = 1440 minutes. Les deux doivent rester
# alignées — dépareillées, l'un des deux chemins d'installation n'est plus
# protégé et personne ne s'en aperçoit.
min-release-age=1
