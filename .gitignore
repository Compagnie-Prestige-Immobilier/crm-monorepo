.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.fleet/
.zed/

# ── Divers ───────────────────────────────────────────────────────────────────
tmp/
temp/
.cache/
*.tgz
*.zip
!**/fixtures/**/*.zip

# Données d'exécution de l'API (APK publiés, imports, enregistrements, dumps)
apps/api/storage/
.claude/worktrees/
