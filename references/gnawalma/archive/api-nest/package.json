{
  "name": "@gnawalma/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dx": "node ./scripts/dx.mjs",
    "start": "node dist/main.js",
    "start:dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node ./node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:e2e": "node ./node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --testRegex '.*integration\\.db\\.test\\.ts$'",
    "migration:check": "node ./scripts/check-migrations.mjs",
    "migration:run": "node ./scripts/run-migrations.mjs",
    "openapi:generate": "npm run build && node dist/src/contracts/generate-openapi.js",
    "openapi:check": "node ./scripts/check-openapi.mjs",
    "seed": "node ./scripts/seed.mjs",
    "admin:create": "node ./scripts/create-admin.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "argon2": "^0.41.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
