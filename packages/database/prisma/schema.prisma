// CRM Prospection CPI : schéma de données.
//
// Deux invariants gouvernent ce schéma :
//
// 1. Les identifiants de Representant et de Prospect sont générés PAR LE CLIENT
//    (UUID v7) et non par la base. L'app mobile crée des lignes hors ligne :
//    si la base attribuait les identifiants, chaque ligne locale aurait besoin
//    d'une réconciliation d'identifiant à la synchronisation, et toute
//    référence locale (un prospect pointant vers son représentant) deviendrait
//    caduque. UUID v7 donne en prime un ordre lexicographique = ordre temporel.
//
// 2. Le numéro de téléphone normalisé en E.164 est la clé de déduplication
//    métier, pour les deux entités. La normalisation doit être identique côté
//    serveur et côté mobile, sinon la contrainte devient aléatoire.
//
//    L'unicité est un index PARTIEL (`WHERE deleted_at IS NULL`), posé en SQL
//    brut dans la migration parce que Prisma ne sait pas exprimer un index
//    partiel. Un `@unique` ordinaire réserverait le numéro à vie après une
//    suppression logique : le commercial supprime une fiche saisie par erreur,
//    puis ne peut plus jamais ressaisir ce numéro, sans le moindre message
//    compréhensible. Voir prisma/migrations/*/partial_unique_phone.sql.
//
// L'identifiant client ne supprime PAS toute réconciliation : il supprime la
// réconciliation d'IDENTIFIANT. Deux commerciaux qui rencontrent le même
// représentant produisent deux UUID pour une seule personne réelle : le
// téléphone les réunit, et c'est le seul remappage d'identifiant du système
// (voir le service de synchronisation).

generator client {
  provider = "prisma-client-js"
}

// Pas d'`url` ici : Prisma 7 l'interdit dans le schéma et exige que la chaîne
// de connexion vienne de `prisma.config.ts`. Ce fichier doit donc être présent
// DANS L'IMAGE de production, sans quoi `migrate deploy` ne sait pas où se
// connecter et l'API redémarre en boucle.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMMERCIAL
  BANQUE_FINANCE
  SUPERVISEUR
}

// Où en est la relation avec un représentant, du point de vue de l'équipe qui
// l'appelle. Pas un booléen : `false` confondrait « jamais appelé » et « a
// refusé », or c'est exactement cet écart que le pilotage à sept jours compte.
enum RepresentantRelation {
  INCONNU
  CONTACTE
  AMBASSADEUR
  REFUS
}

// Prospection générale (phase 1). NE PAS confondre avec Phase2Status : les deux
// décrivent des dimensions différentes du même prospect et évoluent
// séparément.
enum ProspectStatut {
  NOUVEAU
  CONTACTE
  CONVERTI
  PERDU
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 : collecte des méthodes d'enrôlement
// ─────────────────────────────────────────────────────────────────────────────

enum Phase2Status {
  PENDING
  METHOD_OBTAINED
  REFUSED
  WRONG_NUMBER
}

enum EnrollmentMethod {
  PLATFORM
  PHYSICAL
  VOICE_OR_ELECTRONIC_MESSAGING
}

// BDD1..BDD4 ne sont PAS quatre bases physiques : ce sont des segments calculés
// sur une base consolidée unique, par croisement du syndicat et de la banque.
//
//   BDD1  syndicat CHUES        banque CBAO
//   BDD2  syndicat CHUES        banque ≠ CBAO
//   BDD3  syndicat ≠ CHUES      banque CBAO
//   BDD4  syndicat ≠ CHUES      banque ≠ CBAO
//
// Le segment n'est volontairement pas stocké sur Prospect : il dépend de deux
// clés étrangères, donc une colonne dénormalisée se désynchroniserait dès qu'un
// admin corrige la banque d'un prospect. Il est calculé par le helper partagé
// `segment.ts`, seule définition autorisée : listes, campagnes, statistiques et
// exports en dépendent tous.
enum BddSegment {
  BDD1
  BDD2
  BDD3
  BDD4
}

enum CampaignScope {
  BDD1
  BDD2
  BDD3
  BDD4
  ALL
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

enum CallTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CallOutcome {
  METHOD_OBTAINED
  UNREACHABLE
  CALLBACK
  REFUSED
  WRONG_NUMBER
  OTHER
}

// Issue d'un appel passé à un REPRÉSENTANT, distincte de CallOutcome.
//
// Les deux familles d'appel ne poursuivent pas le même but : appeler un
// prospect sert à obtenir une méthode d'enrôlement, appeler un représentant
// sert à obtenir des fiches. Réutiliser CallOutcome forcerait à y ajouter des
// issues sans objet pour un prospect (« a promis une liste »), et les
// statistiques de phase 2 compteraient alors des appels qui ne la concernent
// pas.
enum RepCallOutcome {
  REACHED
  PROSPECTS_PROMISED
  UNREACHABLE
  CALLBACK
  REFUSED
  WRONG_NUMBER
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Demande de création de client (banque vers administrateur)
// ─────────────────────────────────────────────────────────────────────────────

enum ClientRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Banque & Finance
// ─────────────────────────────────────────────────────────────────────────────

enum BankStageType {
  OPEN
  CASHED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identité
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid(7))
  email        String    @unique
  username     String    @unique
  passwordHash String
  fullName     String
  phoneE164    String?
  role         Role      @default(COMMERCIAL)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  departementId String?
  departement   Departement? @relation(fields: [departementId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens RefreshToken[]
  representants Representant[]
  prospects     Prospect[]
  syncBatches   SyncBatch[]
  auditLogs     AuditLog[]

  // Phase 2
  enrollmentsCaptured Prospect[]               @relation("ProspectEnrollmentCapturedBy")
  campaignsCreated    CallCampaign[]           @relation("CallCampaignCreatedBy")
  campaignMemberships CallCampaignCommercial[] @relation("CallCampaignCommercial")
  callTasksAssigned   CallTask[]               @relation("CallTaskAssignedTo")
  callAttempts        CallAttempt[]            @relation("CallAttemptPerformedBy")

  // Campagnes d'appels aux représentants : module séparé, voir plus bas
  repCampaignsCreated    RepCallCampaign[]           @relation("RepCallCampaignCreatedBy")
  repCampaignMemberships RepCallCampaignCommercial[] @relation("RepCallCampaignCommercial")
  repCallTasksAssigned   RepCallTask[]               @relation("RepCallTaskAssignedTo")
  repCallAttempts        RepCallAttempt[]            @relation("RepCallAttemptPerformedBy")
  repSuggestions         RepresentantSuggestion[]    @relation("RepresentantSuggestionSuggestedBy")

  // Banque & Finance
  bankCasesCreated    BankCase[]           @relation("BankCaseCreatedBy")
  bankCasesUpdated    BankCase[]           @relation("BankCaseUpdatedBy")
  bankCaseTransitions BankCaseTransition[] @relation("BankCaseTransitionBy")

  // Demandes de création de client, ouvertes par une banque et arbitrées par un admin
  clientRequestsMade     ClientCreationRequest[] @relation("ClientCreationRequestRequestedBy")
  clientRequestsReviewed ClientCreationRequest[] @relation("ClientCreationRequestReviewedBy")

  // Démonstration
  appSettingsUpdated AppSetting[] @relation("AppSettingUpdatedBy")

  // Notifications
  deviceTokens           DeviceToken[]          @relation("DeviceTokenUser")
  notificationsCreated   Notification[]         @relation("NotificationCreatedBy")
  notificationDeliveries NotificationDelivery[] @relation("NotificationDeliveryUser")
  notificationTemplates  NotificationTemplate[] @relation("NotificationTemplateCreatedBy")

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  importJobs     ImportJob[]     @relation("ImportJobRequestedBy")
  segmentChanges SegmentChange[] @relation("SegmentChangeChangedBy")

  scheduledCallbacks       ScheduledCallback[]          @relation("ScheduledCallbackAssignedTo")
  representantRelationsSet RepresentantRelationChange[] @relation("RepresentantRelationChangeChangedBy")

  heartbeat AgentHeartbeat?

  @@index([role, isActive])
  @@index([deletedAt])
  @@index([isDemo])
  @@map("users")
}

// Un refresh token n'est jamais stocké en clair : seul son SHA-256 l'est. Une
// fuite de la table ne donne donc pas de session utilisable.
//
// `familyId` implémente la détection de rejeu : chaque rotation crée un nouveau
// token dans la même famille. Si un token déjà consommé (`revokedAt` non nul)
// est représenté, c'est qu'il a été volé : toute la famille est révoquée d'un
// coup et l'utilisateur doit se reconnecter.
model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Référentiels : synchronisés en lecture seule vers le mobile
// ─────────────────────────────────────────────────────────────────────────────

model Region {
  id           String        @id @default(uuid(7))
  code         String        @unique
  name         String        @unique
  departements Departement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("regions")
}

model Departement {
  id       String @id @default(uuid(7))
  code     String @unique
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  representants    Representant[]
  iefs             Ief[]
  notifications    Notification[]    @relation("NotificationAudienceDepartement")
  repCallCampaigns RepCallCampaign[] @relation("RepCallCampaignDepartement")

  @@unique([regionId, name])
  @@index([updatedAt])
  @@map("departements")
}

/// Inspection de l'Éducation et de la Formation.
///
/// Découpage SCOLAIRE, distinct du découpage administratif. Les feuilles de
/// route CHUES sont bâties dessus : un téléconseiller reçoit « IEF Almadies »,
/// jamais « Dakar ». 59 IEF pour 46 départements : Dakar en porte quatre.
///
/// Le rattachement au représentant est FACULTATIF, et le restera : les fiches
/// déjà saisies n'en portent pas, et une colonne obligatoire les rendrait
/// invalides rétroactivement. Le département reste, lui, obligatoire : il est
/// déductible de l'IEF, jamais l'inverse.
model Ief {
  id            String      @id @default(uuid(7))
  code          String      @unique
  name          String
  departementId String
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  representants    Representant[]
  repCallCampaigns RepCallCampaign[] @relation("RepCallCampaignIef")

  @@unique([departementId, name])
  @@index([updatedAt])
  @@map("iefs")
}

model Banque {
  id        String   @id @default(uuid(7))
  name      String   @unique
  shortName String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospects      Prospect[]
  bankCases      BankCase[]
  clientRequests ClientCreationRequest[]

  @@index([updatedAt])
  @@map("banques")
}

model Syndicat {
  id        String   @id @default(uuid(7))
  name      String   @unique
  sigle     String   @unique
  secteur   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospects Prospect[]

  @@index([updatedAt])
  @@map("syndicats")
}

// ─────────────────────────────────────────────────────────────────────────────
// Métier
// ─────────────────────────────────────────────────────────────────────────────

model Representant {
  id        String  @id // UUID v7 généré par le client, jamais par la base
  fullName  String
  // Unicité posée en index partiel dans la migration, pas ici. Voir l'en-tête.
  phoneE164 String
  notes     String?

  // Incrémenté à chaque écriture serveur. Sert au client à ignorer une page de
  // pull plus ancienne que ce qu'il a déjà (`WHERE excluded.rev > rev`).
  rev Int @default(1)

  departementId String
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Restrict)

  /// IEF de rattachement, facultative. Voir le modele `Ief`.
  iefId String?
  ief   Ief?    @relation(fields: [iefId], references: [id], onDelete: Restrict)

  // Le commercial qui l'a saisi le premier. Ne change pas si un autre commercial
  // rattache ensuite des prospects au même représentant : la paternité de la
  // ligne prospect suffit à tracer qui a apporté quoi.
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Horodatage de la saisie sur le terrain, distinct de `createdAt` qui est
  // l'arrivée en base. Les deux peuvent être séparés de plusieurs jours si le
  // commercial est resté hors ligne : les statistiques d'activité s'appuient
  // sur `clientCreatedAt`.
  clientCreatedAt DateTime

  relationStatus RepresentantRelation @default(INCONNU)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  prospects           Prospect[]
  repCallTasks        RepCallTask[]
  repCallAttempts     RepCallAttempt[]
  relationChanges     RepresentantRelationChange[]
  suggestionsGiven    RepresentantSuggestion[]     @relation("RepresentantSuggestionSource")
  suggestionsResolved RepresentantSuggestion[]     @relation("RepresentantSuggestionResolved")

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@index([phoneE164])
  @@index([createdById])
  @@index([createdById, clientCreatedAt])
  @@index([departementId])
  // Le périmètre d'une campagne de représentants se borne par IEF : sans cet
  // index, le tirage parcourt séquentiellement toute la table à chaque aperçu.
  @@index([iefId])
  // Index de pagination du pull delta : keyset sur (updatedAt, id).
  @@index([updatedAt, id])
  @@index([deletedAt])
  @@index([relationStatus])
  @@index([relationStatus, departementId])
  @@index([isDemo])
  @@map("representants")
}

model Prospect {
  id        String @id // UUID v7 généré par le client
  nom       String
  prenom    String
  // Unicité posée en index partiel dans la migration, pas ici.
  phoneE164 String

  rev Int @default(1)

  banqueId   String
  banque     Banque   @relation(fields: [banqueId], references: [id], onDelete: Restrict)
  syndicatId String
  syndicat   Syndicat @relation(fields: [syndicatId], references: [id], onDelete: Restrict)

  // onUpdate: Cascade est porteur. Quand un représentant saisi hors ligne
  // s'avère être un doublon d'une fiche déjà en base, la résolution consiste à
  // réécrire l'identifiant local vers l'identifiant serveur. La cascade fait
  // suivre les prospects rattachés en une instruction au lieu d'une boucle de
  // rattrapage manuelle.
  representantId String
  representant   Representant @relation(fields: [representantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  statut ProspectStatut @default(NOUVEAU)

  /// Provenance de la fiche quand elle N'EST PAS née d'une tournée terrain.
  ///
  /// Vide pour l'écrasante majorité des lignes : le chemin normal reste la
  /// saisie mobile par un commercial, et `createdById` suffit alors à dire d'où
  /// vient la fiche. La colonne ne se remplit que sur les entrées exceptionnelles
  /// (aujourd'hui `BANQUE`, via une demande de création approuvée), pour qu'un
  /// administrateur puisse mesurer ce qui entre hors base au lieu de le deviner.
  ///
  /// `originLabel` porte le détail lisible (nom de la banque demandeuse) et non
  /// une clé étrangère : le libellé doit survivre au renommage du référentiel,
  /// exactement comme l'identité recopiée sur un dossier bancaire.
  origin      String?
  originLabel String?

  // ── Phase 2 : méthode d'enrôlement ──────────────────────────────────────
  // Dimension indépendante de `statut`. Invariant applicatif, testé :
  // `enrollmentMethod` est OBLIGATOIRE si et seulement si
  // `phase2Status = METHOD_OBTAINED`, et NULL pour tous les autres statuts.
  // Il est aussi posé en contrainte CHECK dans la migration, pour qu'aucun
  // chemin d'écriture : y compris un correctif SQL manuel : ne puisse le violer.
  phase2Status           Phase2Status      @default(PENDING)
  enrollmentMethod       EnrollmentMethod?
  enrollmentCapturedAt   DateTime?
  enrollmentCapturedById String?
  enrollmentCapturedBy   User?             @relation("ProspectEnrollmentCapturedBy", fields: [enrollmentCapturedById], references: [id], onDelete: SetNull)

  clientCreatedAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  callTasks          CallTask[]
  callAttempts       CallAttempt[]
  scheduledCallbacks ScheduledCallback[]
  bankCases          BankCase[]
  clientRequests     ClientCreationRequest[]

  segmentChanges SegmentChange[]

  @@index([phoneE164])
  @@index([representantId])
  // `origin` est indexée en index PARTIEL (`WHERE "origin" IS NOT NULL`) dans
  // la migration, pas ici : Prisma ne sait pas exprimer la clause `WHERE`, et
  // un index complet porterait les centaines de milliers de lignes sans
  // provenance pour ne jamais servir. Voir `prospects_origin_idx`.
  @@index([createdById])
  // Activite d'un teleconseiller sur une journee de travail, saisie terrain.
  @@index([createdById, clientCreatedAt])
  @@index([banqueId])
  @@index([syndicatId])
  @@index([statut])
  @@index([clientCreatedAt])
  @@index([updatedAt, id])
  @@index([deletedAt])
  // Le segment BDD est calculé par croisement (syndicatId, banqueId) : cet
  // index composite sert le filtrage par segment sur 500 000 lignes sans
  // dénormaliser une colonne qui se désynchroniserait.
  @@index([syndicatId, banqueId])
  @@index([phase2Status])
  @@index([enrollmentMethod])
  @@index([isDemo])
  @@map("prospects")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mécanique de synchronisation
// ─────────────────────────────────────────────────────────────────────────────

// L'idempotence tient sur DEUX niveaux. Aucun des deux ne suffit seul.
//
// Niveau 1 : le lot. Le mobile envoie `Idempotency-Key: <batchId>`. Si le
// réseau coupe après que le serveur a écrit mais avant que la réponse n'arrive,
// le client rejoue le lot identique et retrouve ici la réponse mémorisée.
//
// Niveau 2 : l'opération (modèle SyncOperation). Indispensable parce que le
// niveau 1 ne couvre PAS le cas réel suivant : 3 opérations sur 5 passent, le
// client reconstitue un lot DIFFÉRENT sous un NOUVEAU batchId. La clé de lot ne
// reconnaît rien ; seules les clés par opération rendent ce rejeu sûr.
//
// La clé primaire composite (userId, key) empêche le rejeu d'une clé volée par
// un autre compte.
//
// `requestHash` détecte la réutilisation d'une clé avec un corps différent :
// c'est un bug client, on refuse plutôt que de renvoyer silencieusement une
// réponse sans rapport.
//
// L'insertion du marqueur `IN_PROGRESS` se fait dans sa PROPRE transaction,
// AVANT la transaction de travail. Placée dedans, un rollback l'effacerait et
// le rejeu réécrirait : c'est l'erreur classique sur ce motif.
model SyncBatch {
  key          String      @map("idempotency_key")
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestHash  String
  status       BatchStatus @default(IN_PROGRESS)
  httpStatus   Int?
  responseJson Json?
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
  expiresAt    DateTime

  operations SyncOperation[]

  @@id([userId, key])
  @@index([expiresAt])
  @@map("sync_batches")
}

enum BatchStatus {
  IN_PROGRESS
  COMPLETED
}

enum OperationResult {
  APPLIED
  DUPLICATE
  CONFLICT
  INVALID
  SKIPPED_DEPENDENCY_FAILED
}

model SyncOperation {
  opId       String          @id
  userId     String
  batchKey   String
  batch      SyncBatch       @relation(fields: [userId, batchKey], references: [userId, key], onDelete: Cascade)
  entityType String
  entityId   String
  result     OperationResult
  resultJson Json?
  appliedAt  DateTime        @default(now())

  @@index([userId, appliedAt])
  @@index([entityId])
  @@map("sync_operations")
}

/// Dernier échange d'un appareil avec le serveur, UNE ligne par compte.
///
/// La colonne équivalente sur `users` a été refusée : une écriture par requête
/// sur la table la plus lue du produit. Une table étroite, sans index
/// secondaire ni relation entrante, n'a pas ce défaut.
///
/// `pendingOps` vient du CLIENT et de nulle part ailleurs : le serveur ne voit
/// que ce qui lui est remonté, jamais ce qui attend dans l'outbox du téléphone.
model AgentHeartbeat {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastPullAt DateTime?
  lastPushAt DateTime?
  /// NULLABLE et sans valeur par défaut : un appareil qui ne l'annonce pas
  /// laisse « inconnu », et non « zéro en attente », qui serait un fait faux.
  pendingOps Int?
  appVersion String?

  updatedAt DateTime @updatedAt

  @@map("agent_heartbeats")
}

model AuditLog {
  id       String   @id @default(uuid(7))
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, at])
  @@index([at])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// Phase 2 : campagnes d'appels et collecte des méthodes
// ═════════════════════════════════════════════════════════════════════════════

// Une campagne fige une répartition. La graine de mélange est PERSISTÉE parce
// que la répartition doit être reproductible et surtout stable : consulter la
// campagne ou retélécharger un PDF ne doit jamais retirer au sort. Les
// affectations sont matérialisées dans CallTask ; la graine ne sert qu'à
// pouvoir rejouer et auditer le tirage.
model CallCampaign {
  id     String         @id @default(uuid(7))
  name   String
  scope  CampaignScope
  seed   String
  status CampaignStatus @default(ACTIVE)

  /// Nombre de journées sur lesquelles la file de chaque commercial est étalée.
  ///
  /// Vaut 1 par défaut, ce qui reproduit exactement le comportement antérieur.
  /// Au-delà, la file de chaque commercial est découpée en tranches contiguës :
  /// sur 120 000 fiches et 7 jours, un commercial reçoit sept programmes tenables
  /// au lieu d'un seul illisible. La répartition reste reproductible à graine
  /// égale, puisqu'elle se fait APRÈS le tirage et non pendant.
  spreadDays Int @default(1)

  createdById String
  createdBy   User   @relation("CallCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  commerciaux CallCampaignCommercial[]
  tasks       CallTask[]
  attempts    CallAttempt[]
  callbacks   ScheduledCallback[]

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@index([status, createdAt])
  @@index([isDemo])
  @@map("call_campaigns")
}

model CallCampaignCommercial {
  id         String       @id @default(uuid(7))
  campaignId String
  campaign   CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation("CallCampaignCommercial", fields: [userId], references: [id], onDelete: Restrict)
  // Rang dans le round-robin. Fige l'ordre de distribution, donc le contenu de
  // chaque PDF, indépendamment de l'ordre de lecture en base.
  position   Int

  @@unique([campaignId, userId])
  @@unique([campaignId, position])
  @@map("call_campaign_commerciaux")
}

// Une tâche est une ligne du programme papier d'un commercial.
//
// `isActive` est une colonne dédiée plutôt qu'un simple `status = OPEN` : elle
// porte l'index unique partiel qui interdit deux tâches actives sur le même
// prospect. Sans lui, deux campagnes simultanées pourraient distribuer le même
// numéro à deux commerciaux.
model CallTask {
  id         String       @id @default(uuid(7))
  campaignId String
  campaign   CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId String
  prospect   Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("CallTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  // Rang dans le PDF du commercial, à partir de 1. L'ordre du PDF doit être
  // exactement celui-ci : c'est ce qui rend le papier et l'écran cohérents.
  position Int

  /// Journée d'étalement, à partir de 0 (donc « jour 1 » à l'affichage).
  ///
  /// Écrit à la création, jamais recalculé : le programme du jour 3 doit rendre
  /// le même document une semaine plus tard. Vaut 0 partout quand la campagne
  /// n'est pas étalée, ce qui laisse les campagnes existantes intactes.
  dayIndex Int @default(0)

  status   CallTaskStatus @default(OPEN)
  isActive Boolean        @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  attempts  CallAttempt[]
  callbacks ScheduledCallback[]

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@unique([campaignId, prospectId])
  @@unique([campaignId, assignedToId, position])
  @@index([assignedToId, status])
  @@index([assignedToId, completedAt])
  @@index([prospectId])
  // Le PDF « jour N » d'un commercial lit exactement cette clé.
  @@index([campaignId, assignedToId, dayIndex])
  @@index([isDemo])
  @@map("call_tasks")
}

// Historique append-only des tentatives. Une tentative n'est jamais modifiée.
//
// `performedById` est le commercial qui a RÉELLEMENT passé l'appel, distinct de
// `CallTask.assignedToId`. N'importe quel commercial authentifié peut compléter
// un numéro trouvé dans l'annuaire, y compris un numéro attribué à un collègue :
// il faut donc conserver les deux pour que l'attribution reste juste.
model CallAttempt {
  // UUID v7 généré par le mobile : sert aussi de clé d'idempotence.
  id         String        @id
  prospectId String
  prospect   Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       CallTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  performedById String
  performedBy   User   @relation("CallAttemptPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  outcome CallOutcome
  method  EnrollmentMethod?
  // Obligatoire quand outcome = OTHER, facultatif sinon. Contrainte CHECK.
  comment String?

  clientCreatedAt DateTime
  createdAt       DateTime @default(now())

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@index([prospectId, createdAt])
  @@index([performedById, createdAt])
  // La journee de travail se lit sur `clientCreatedAt`, l'heure de l'appel.
  @@index([performedById, clientCreatedAt])
  @@index([campaignId])
  @@index([isDemo])
  @@map("call_attempts")
}

// Un rappel promis, avec sa date. `CallOutcome.CALLBACK` existait sans qu'aucune
// date ne soit stockée nulle part : personne ne pouvait savoir quand, donc
// personne ne saurait jamais si le rappel a eu lieu.
//
// Table dédiée, et non une colonne. Sur `CallTask`, la date serait perdue dès
// qu'un appel se fait hors campagne depuis l'annuaire, et effacée à la clôture
// de campagne qui passe les tâches à CANCELLED. Sur `Prospect`, deux campagnes
// et deux téléconseillers se partageraient une seule date, ce que l'index
// `call_tasks_one_active_per_prospect` existe précisément pour empêcher.
//
// Le retard est DÉRIVÉ (`status = 'PENDING' AND scheduledAt < now()`), jamais
// stocké : un `missedAt` obligerait un cron à réécrire des millions de lignes
// pour une information calculable.
model ScheduledCallback {
  id         String        @id @default(uuid(7))
  prospectId String
  prospect   Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       CallTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Le `performedById` de la tentative source, pas l'assigné de la tâche : c'est
  // celui qui a promis le rappel qui le doit.
  assignedToId String
  assignedTo   User   @relation("ScheduledCallbackAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  // Stocké en UTC, saisi en Africa/Dakar.
  scheduledAt DateTime
  comment     String?

  /// Une tentative produit AU PLUS un rappel : l'unicité rend le rejeu d'une
  /// même tentative sans effet, sans compter les lignes au préalable.
  sourceAttemptId String @unique

  status          ScheduledCallbackStatus @default(PENDING)
  closedAttemptId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  /// La file du jour d'un téléconseiller, relue à chaque ouverture de l'écran.
  @@index([assignedToId, status, scheduledAt])
  @@index([prospectId, status])
  /// Les rappels dus toutes files confondues, pour la supervision.
  @@index([scheduledAt, status])
  @@index([isDemo])
  @@map("scheduled_callbacks")
}

enum ScheduledCallbackStatus {
  PENDING
  DONE
  CANCELLED
  SUPERSEDED
}

// ═════════════════════════════════════════════════════════════════════════════
// Campagnes d'appels aux REPRÉSENTANTS
//
// Module SÉPARÉ, et non un `kind` ajouté sur CallCampaign. Les deux familles
// partagent la mécanique (graine persistée, tourniquet, tâche par cible,
// journal d'appels en ajout seul) mais rien de leur métier : la cible n'est pas
// la même table, les issues d'appel ne sont pas les mêmes, et surtout la
// campagne prospects porte l'invariant « une seule tâche active par prospect »
// qui décide de l'éligibilité de la phase 2. Greffer les représentants dessus
// mettrait cet invariant en jeu à chaque évolution du nouveau besoin, sur la
// fonctionnalité qui porte aujourd'hui toute la collecte des méthodes.
// ═════════════════════════════════════════════════════════════════════════════

model RepCallCampaign {
  id     String         @id @default(uuid(7))
  name   String
  seed   String
  status CampaignStatus @default(ACTIVE)

  /// Voir `CallCampaign.spreadDays` : même sémantique, même valeur par défaut.
  spreadDays Int @default(1)

  /// Périmètre du tirage. Les deux bornes sont FACULTATIVES et se cumulent ;
  /// aucune des deux ne vaut « tous les représentants du pays ».
  departementId String?
  departement   Departement? @relation("RepCallCampaignDepartement", fields: [departementId], references: [id], onDelete: SetNull)
  iefId         String?
  ief           Ief?         @relation("RepCallCampaignIef", fields: [iefId], references: [id], onDelete: SetNull)

  /// Ne retenir que les représentants n'ayant apporté AUCUN prospect vivant.
  /// C'est la campagne de relance des dormants, celle qui a motivé le module.
  onlyWithoutProspects Boolean @default(false)

  createdById String
  createdBy   User   @relation("RepCallCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  commerciaux RepCallCampaignCommercial[]
  tasks       RepCallTask[]
  attempts    RepCallAttempt[]

  /// Ligne appartenant au jeu de démonstration. Voir `User.isDemo`.
  isDemo Boolean @default(false)

  @@index([status, createdAt])
  @@index([isDemo])
  @@map("rep_call_campaigns")
}

model RepCallCampaignCommercial {
  id         String          @id @default(uuid(7))
  campaignId String
  campaign   RepCallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("RepCallCampaignCommercial", fields: [userId], references: [id], onDelete: Restrict)
  // Rang dans le tourniquet. Fige la distribution, donc le contenu de chaque PDF.
  position   Int

  @@unique([campaignId, userId])
  @@unique([campaignId, position])
  @@map("rep_call_campaign_commerciaux")
}

// Une tâche est une ligne du programme papier d'un commercial.
//
// `isActive` porte l'index unique partiel qui interdit deux tâches actives sur
// le même représentant : sans lui, deux campagnes simultanées distribueraient le
// même numéro à deux commerciaux, qui appelleraient la même personne le même
// matin.
model RepCallTask {
  id             String          @id @default(uuid(7))
  campaignId     String
  campaign       RepCallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  representantId String
  representant   Representant    @relation(fields: [representantId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("RepCallTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  position Int
  /// Voir `CallTask.dayIndex`.
  dayIndex Int @default(0)

  status   CallTaskStatus @default(OPEN)
  isActive Boolean        @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  attempts RepCallAttempt[]

  /// Ligne appartenant au jeu de démonstration. Voir `User.isDemo`.
  isDemo Boolean @default(false)

  @@unique([campaignId, representantId])
  @@unique([campaignId, assignedToId, position])
  @@index([assignedToId, status])
  @@index([representantId])
  @@index([campaignId, assignedToId, dayIndex])
  @@index([isDemo])
  @@map("rep_call_tasks")
}

/// Historique en AJOUT SEUL des appels passés aux représentants. Une tentative
/// n'est jamais modifiée : elle décrit un fait daté.
model RepCallAttempt {
  // UUID v7 engendré par le client : sert aussi de clé d'idempotence.
  id             String           @id
  representantId String
  representant   Representant     @relation(fields: [representantId], references: [id], onDelete: Cascade)
  taskId         String?
  task           RepCallTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       RepCallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  performedById String
  performedBy   User   @relation("RepCallAttemptPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  outcome           RepCallOutcome
  /// Nombre de fiches promises par le représentant, quand l'issue le prévoit.
  promisedProspects Int?
  comment           String?

  clientCreatedAt DateTime
  createdAt       DateTime @default(now())

  /// Ligne appartenant au jeu de démonstration. Voir `User.isDemo`.
  isDemo Boolean @default(false)

  suggestion RepresentantSuggestion?

  @@index([representantId, createdAt])
  @@index([performedById, createdAt])
  @@index([performedById, clientCreatedAt])
  @@index([campaignId])
  @@index([isDemo])
  @@map("rep_call_attempts")
}

// ═════════════════════════════════════════════════════════════════════════════
// Demande de création de client
// ═════════════════════════════════════════════════════════════════════════════

/// Une banque saisit un dossier pour un client absent de la base.
///
/// Sans cette table, l'agent était dans une impasse : « Aucun client ne
/// correspond », et rien ne remontait à l'administrateur. Le rôle
/// BANQUE_FINANCE n'a pas : et ne doit pas avoir : le droit de créer un
/// prospect : il ne voit ni le représentant, ni le syndicat, ni le commercial
/// propriétaire, donc la fiche qu'il produirait serait incomplète et sans
/// paternité. La demande passe donc par un arbitrage explicite.
///
/// L'identité saisie est CONSERVÉE telle quelle même après approbation : c'est
/// elle qui permet de comprendre, des mois plus tard, ce que la banque avait
/// réellement demandé quand le prospect créé a été corrigé depuis.
model ClientCreationRequest {
  id String @id @default(uuid(7))

  nom       String
  prenom    String
  /// Normalisé en E.164 par le serveur, avec la MÊME fonction que partout
  /// ailleurs : c'est ce qui permet de refuser une demande portant sur un
  /// prospect déjà en base.
  phoneE164 String
  note      String?

  /// Banque demandeuse. Sert de `originLabel` au prospect créé.
  banqueId String
  banque   Banque @relation(fields: [banqueId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("ClientCreationRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  status ClientRequestStatus @default(PENDING)

  reviewedById  String?
  reviewedBy    User?     @relation("ClientCreationRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  rejectionNote String?

  /// Prospect issu de l'approbation. Nul tant que la demande n'a pas abouti.
  ///
  /// `Restrict` et non `SetNull`. La contrainte CHECK
  /// `client_creation_requests_approved_has_prospect` exige qu'une demande
  /// APPROUVÉE porte son prospect : remettre la colonne à NULL à la suppression
  /// du prospect ferait échouer cette suppression sur une violation de CHECK,
  /// message illisible pour l'administrateur qui efface une fiche. Le refus
  /// franc est plus honnête, et la purge administrative efface les demandes
  /// AVANT les prospects (`purge-plan.ts`).
  createdProspectId String?
  createdProspect   Prospect? @relation(fields: [createdProspectId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ligne appartenant au jeu de démonstration. Voir `User.isDemo`.
  isDemo Boolean @default(false)

  // Unicité de la FILE D'ATTENTE (un seul PENDING par numéro) posée en index
  // partiel dans la migration : Prisma ne sait pas exprimer la clause `WHERE`.
  // Voir `client_creation_requests_pending_phone_key`.
  @@index([status, createdAt])
  @@index([requestedById])
  @@index([phoneE164])
  // L'écran d'arbitrage filtre par banque demandeuse, et la purge des banques
  // doit pouvoir vérifier la clé étrangère sans parcourir toute la table.
  @@index([banqueId])
  @@index([isDemo])
  @@map("client_creation_requests")
}

// ═════════════════════════════════════════════════════════════════════════════
// Banque & Finance
// ═════════════════════════════════════════════════════════════════════════════

// Étapes du workflow, configurables par l'ADMIN : mais seulement les étapes
// OPEN intermédiaires. Les trois étapes système (initiale, encaissé, rejeté)
// portent des règles financières fixes et ne peuvent être ni supprimées ni
// désactivées.
//
// Une étape n'est JAMAIS supprimée physiquement dès lors qu'elle apparaît dans
// l'historique : la timeline d'un dossier clos doit rester lisible des années
// après qu'une étape a été retirée du workflow courant.
model BankCaseStage {
  id       String        @id @default(uuid(7))
  code     String        @unique
  label    String
  position Int
  color    String
  type     BankStageType

  isActive  Boolean @default(true)
  isInitial Boolean @default(false)
  isSystem  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  casesCurrent    BankCase[]           @relation("BankCaseCurrentStage")
  transitionsFrom BankCaseTransition[] @relation("BankCaseTransitionFrom")
  transitionsTo   BankCaseTransition[] @relation("BankCaseTransitionTo")

  @@index([type, isActive, position])
  @@map("bank_case_stages")
}

// Référentiel des motifs de rejet, géré par l'ADMIN. En référentiel plutôt
// qu'en texte libre parce que le tableau de bord affiche une répartition des
// motifs : sur du texte saisi à la main, ce graphique serait illisible.
// `BankCase.rejectionDetail` reste disponible pour la précision libre.
model BankRejectionReason {
  id        String   @id @default(uuid(7))
  code      String   @unique
  label     String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases       BankCase[]
  transitions BankCaseTransition[]

  @@map("bank_rejection_reasons")
}

model BankCase {
  id String @id @default(uuid(7))

  // `reference` est la saisie de l'agent, affichée telle quelle.
  // `referenceKey` est sa forme normalisée (majuscules, espaces compactés) et
  // porte l'unicité globale : « ABC-123 » et « abc 123 » sont la même référence.
  reference    String
  referenceKey String @unique

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  // Identité COPIÉE à la création, volontairement dénormalisée. Un dossier
  // bancaire est une pièce à valeur historique : si un admin corrige plus tard
  // le nom ou le téléphone du prospect, le dossier doit continuer de refléter
  // ce qui a été transmis à la banque ce jour-là.
  customerName      String
  customerPhoneE164 String

  processingBankId String
  processingBank   Banque @relation(fields: [processingBankId], references: [id], onDelete: Restrict)

  currentStageId String
  currentStage   BankCaseStage @relation("BankCaseCurrentStage", fields: [currentStageId], references: [id], onDelete: Restrict)

  // XOF n'a pas de décimales. Decimal(18,0) plutôt qu'un flottant, et exposé en
  // chaîne dans l'API : un montant qui transite en JSON number peut perdre de
  // la précision au-delà de 2^53.
  amountXof Decimal? @db.Decimal(18, 0)

  rejectionReasonId String?
  rejectionReason   BankRejectionReason? @relation(fields: [rejectionReasonId], references: [id], onDelete: Restrict)
  rejectionDetail   String?

  // Concurrence optimiste. Deux agents sur la même révision : le second reçoit
  // BANK_CASE_REV_CONFLICT et recharge au lieu d'écraser en silence.
  rev Int @default(1)

  createdById String
  createdBy   User    @relation("BankCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("BankCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transitions BankCaseTransition[]

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@index([currentStageId])
  @@index([processingBankId])
  @@index([createdById])
  @@index([prospectId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([isDemo])
  @@map("bank_cases")
}

// Historique append-only. Chaque changement de statut écrit une transition ET
// met à jour le dossier dans la MÊME transaction : un dossier ne peut pas
// avancer sans laisser de trace, ni laisser une trace sans avoir avancé.
model BankCaseTransition {
  id     String   @id @default(uuid(7))
  caseId String
  case   BankCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   BankCaseStage? @relation("BankCaseTransitionFrom", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStageId   String
  toStage     BankCaseStage  @relation("BankCaseTransitionTo", fields: [toStageId], references: [id], onDelete: Restrict)

  performedById String
  performedBy   User   @relation("BankCaseTransitionBy", fields: [performedById], references: [id], onDelete: Restrict)

  amountXof         Decimal?             @db.Decimal(18, 0)
  rejectionReasonId String?
  rejectionReason   BankRejectionReason? @relation(fields: [rejectionReasonId], references: [id], onDelete: Restrict)
  rejectionDetail   String?
  comment           String?

  // Renseigné uniquement quand un ADMIN corrige un dossier terminal. Sa
  // présence est ce qui distingue une correction d'une avancée normale.
  correctionReason String?

  clientAt  DateTime?
  createdAt DateTime  @default(now())

  /// Ligne appartenant au jeu de démonstration.
  ///
  /// Le mode démo est une BASCULE D'AFFICHAGE, pas une insertion suivie d'une
  /// suppression : les lignes de démo coexistent en permanence avec les vraies,
  /// et l'interrupteur ne fait que les montrer ou les cacher. Rien n'est jamais
  /// détruit, et surtout une ligne de démo ne peut pas se retrouver dans un
  /// export réel : elle est invisible dès que le mode est éteint.
  isDemo Boolean @default(false)

  @@index([caseId, createdAt])
  @@index([performedById, createdAt])
  @@index([toStageId])
  @@index([isDemo])
  @@map("bank_case_transitions")
}

// ═════════════════════════════════════════════════════════════════════════════
// Mode démonstration
// ═════════════════════════════════════════════════════════════════════════════

/// Réglages de la plateforme, en clé/valeur. Une table plutôt qu'une variable
/// d'environnement : l'interrupteur se manœuvre depuis le panel admin, en
/// production, sans redéploiement.
model AppSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedBy   User?    @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

/// Registre EXACT de tout ce que le semeur de démonstration a créé.
///
/// C'est la pièce qui rend l'interrupteur sûr. Désactiver le mode démo supprime
/// précisément les identifiants listés ici, et rien d'autre.
///
/// L'alternative : supprimer par heuristique, « tout ce dont le nom commence
/// par Démo » ou « tout ce qui a été créé après telle date » : est à proscrire :
/// le jour où un vrai commercial saisit un prospect pendant une démonstration,
/// l'heuristique l'efface, et personne ne comprend pourquoi la fiche a disparu.
///
/// `sequence` fixe l'ordre de création ; la suppression le parcourt à l'envers,
/// ce qui satisfait les clés étrangères sans coder de tri topologique.
model DemoEntity {
  id         String   @id @default(uuid(7))
  entityType String
  entityId   String
  sequence   Int
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([sequence])
  @@map("demo_entities")
}

// ═════════════════════════════════════════════════════════════════════════════
// Notifications
// ═════════════════════════════════════════════════════════════════════════════

/// Nature du message. Sert au filtrage de la boîte de réception et à la mise en
/// avant côté client (un rappel ne se présente pas comme une annonce).
enum NotificationCategory {
  ANNONCE
  RAPPEL
  CAMPAGNE
  DOSSIER
  SYSTEME
}

/// À qui la notification s'adresse. Le public est figé À L'ENVOI dans les
/// lignes NotificationDelivery : muter un utilisateur de département après coup
/// ne réécrit pas l'histoire de ce qui a été expédié.
enum NotificationAudience {
  ALL
  ROLE
  DEPARTEMENT
  USERS
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// SOUS-SYSTÈME RETIRÉ. Table conservée UNE VERSION, puis supprimée.
///
/// Firebase a quitté l'application mobile : plus aucun client ne peut produire
/// un jeton d'enregistrement, les deux routes qui alimentaient cette table sont
/// parties avec lui, et AUCUN code de ce dépôt ne lit ni n'écrit ce modèle. Il
/// n'y a rien à construire ici, et rien à y brancher : lire ces lignes comme
/// une fonctionnalité vivante serait un contresens.
///
/// POURQUOI ELLE N'EST PAS DÉJÀ SUPPRIMÉE. La suppression était écrite, puis
/// retirée de cette version. La version actuellement en production sélectionne
/// ces colonnes nommément, comme le fait tout client Prisma : les faire
/// disparaître rendrait le retour arrière de l'application impossible sans
/// restaurer la base au préalable, et aucune restauration n'a jamais été
/// éprouvée sur cette installation. Le reste de cette version n'ajoute que des
/// tables et des colonnes ; cette suppression était, à elle seule, ce qui la
/// rendait irréversible.
///
/// CE QUI LÈVE LA CONSERVATION : une sauvegarde restaurée avec succès, puis la
/// migration décrite dans `docs/migrations-en-attente.md`, déployée seule.
model DeviceToken {
  id     String @id @default(uuid(7))
  userId String
  user   User   @relation("DeviceTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  appVersion String?

  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  pendingOps   Int       @default(0)
  pendingSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ligne appartenant au jeu de démonstration.
  isDemo Boolean @default(false)

  @@index([userId, revokedAt])
  @@index([revokedAt])
  @@index([isDemo])
  @@map("device_tokens")
}

enum NotificationStatus {
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// Cycle de vie d'un envoi vers UN destinataire.
///
/// `SENT` signifie « e-mail accepté par Brevo », pas « lu ». `PENDING` n'est
/// PAS un échec : le destinataire non servi par e-mail lit dans l'application,
/// et une ligne en file peut aussi attendre un réessai après un incident
/// passager. La distinction compte : un taux de SENT à 100 % avec zéro READ
/// décrit un problème, pas un succès.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

/// Gabarit réutilisable, éditable par l'ADMIN.
///
/// Les variables sont écrites `{{nom}}` dans le titre comme dans le corps.
/// `variables` documente celles que le gabarit attend : c'est ce que le
/// compositeur web affiche à l'auteur. Une variable manquante à la substitution
/// n'est pas une erreur fatale : le texte est rendu sans elle et le nom manquant
/// est remonté à l'appelant, parce qu'un rappel amputé vaut mieux qu'un rappel
/// non envoyé.
model NotificationTemplate {
  id       String               @id @default(uuid(7))
  name     String               @unique
  category NotificationCategory @default(ANNONCE)

  titleTemplate String
  bodyTemplate  String
  route         String?
  variables     String[] @default([])

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("NotificationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  /// Ligne appartenant au jeu de démonstration.
  isDemo Boolean @default(false)

  @@index([category])
  @@index([isDemo])
  @@map("notification_templates")
}

/// Un envoi, immédiat ou programmé.
///
/// `reminderKey` + `period` portent l'idempotence des rappels récurrents : le
/// couple est unique, donc deux instances de l'API qui déclenchent le même
/// rappel à la même minute produisent une insertion et un conflit, pas deux
/// notifications. Les envois manuels laissent les deux à NULL : en PostgreSQL
/// les NULL ne se heurtent jamais dans un index unique, ce qui laisse le
/// compositeur libre de renvoyer deux fois le même texte.
model Notification {
  id       String               @id @default(uuid(7))
  title    String
  body     String
  category NotificationCategory @default(ANNONCE)

  /// Route applicative ouverte au tap, ex. `/phase2?phone=+221771234567`.
  /// Volontairement une route interne et non une URL : le mobile la donne
  /// telle quelle à go_router, sans jamais ouvrir de navigateur.
  route String?

  /// RETIRÉE DE L'USAGE, CONSERVÉE EN BASE LE TEMPS D'UNE VERSION.
  ///
  /// Cette colonne n'était relue que par la construction du message FCM, et
  /// plus aucun code ne l'écrit ni ne la lit depuis le retrait de Firebase.
  /// Elle reste déclarée pour que cette version RESTE RÉVERSIBLE : le code
  /// actuellement en production sélectionne cette colonne nommément, et la
  /// supprimer maintenant rendrait impossible tout retour en arrière de
  /// l'application sans restauration de la base. Voir `docs/migrations-en-
  /// attente.md`.
  payload Json?

  audience              NotificationAudience @default(ALL)
  audienceRole          Role?
  audienceDepartementId String?
  audienceDepartement   Departement?         @relation("NotificationAudienceDepartement", fields: [audienceDepartementId], references: [id], onDelete: SetNull)
  audienceUserIds       String[]             @default([])

  status       NotificationStatus @default(SENT)
  scheduledFor DateTime?
  sentAt       DateTime?
  cancelledAt  DateTime?

  /// Renseigné quand aucun transport n'était configuré : les lignes de
  /// livraison existent, la remise n'a pas eu lieu. L'admin doit le voir.
  transportStatus String?

  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reminderKey String?
  period      String?

  /// IDENTITÉ DU DÉTENTEUR DU BAIL D'EXPÉDITION. `null` quand personne ne tient
  /// l'envoi.
  ///
  /// `status = SENDING` + `updatedAt` disaient QU'UN processus travaillait, sans
  /// jamais dire LEQUEL. Un bail sans identité de propriétaire n'en est pas un :
  /// un expéditeur dont le bail avait expiré, repris entre-temps par un second,
  /// se réveillait, renouvelait le bail DU SECOND en écrivant `SENDING`, et
  /// continuait d'envoyer sur les mêmes livraisons. Les deux se croyaient seuls.
  ///
  /// Chaque prise écrit ici un jeton neuf, et toute écriture d'expédition porte
  /// ce jeton dans son `where` : celui qui ne l'a plus n'écrit plus rien. C'est
  /// la même forme que `outbox.claimToken` côté mobile, pour la même raison.
  dispatchClaim String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  /// Ligne appartenant au jeu de démonstration.
  isDemo Boolean @default(false)

  @@unique([reminderKey, period])
  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([category])
  @@index([createdById])
  @@index([isDemo])
  @@map("notifications")
}

/// Une ligne par destinataire. C'est cette table, et elle seule, qui rend
/// « qui a réellement reçu ? » répondable.
///
/// `reminderKey`/`period` y sont RECOPIÉS pour porter la contrainte
/// `(reminderKey, userId, period)` : même si un rappel était recréé, un
/// utilisateur ne peut pas recevoir deux fois le même rappel sur la même
/// période. La garantie est dans l'index, pas dans la discipline de l'appelant.
model NotificationDelivery {
  id             String       @id @default(uuid(7))
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NotificationDeliveryUser", fields: [userId], references: [id], onDelete: Cascade)

  status NotificationDeliveryStatus @default(PENDING)

  /// RETIRÉE DE L'USAGE, CONSERVÉE EN BASE LE TEMPS D'UNE VERSION.
  /// Même raison que `Notification.payload` : plus aucun code ne l'écrit, mais
  /// la version en production la sélectionne. Voir `docs/migrations-en-attente.md`.
  deviceToken String?

  /// Marqueur d'issue, jamais un statut : `INBOX_ONLY` quand le destinataire
  /// n'est pas servi par e-mail, `EMAIL_RETRY` quand un échec passager laisse
  /// la ligne en file, sinon le code d'erreur rendu par Brevo.
  error String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  reminderKey String?
  period      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ligne appartenant au jeu de démonstration.
  isDemo Boolean @default(false)

  @@unique([notificationId, userId])
  @@unique([reminderKey, userId, period])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([notificationId, status])
  @@index([isDemo])
  @@map("notification_deliveries")
}

// ═════════════════════════════════════════════════════════════════════════════
// IMPORTS DE MASSE
// ═════════════════════════════════════════════════════════════════════════════
//
// UN TRAVAIL LONG NE VIT PAS DANS UNE REQUÊTE HTTP.
//
// L'import des représentants tenait dans un appel : lecture du classeur en
// mémoire, écriture dans une transaction de soixante secondes, plafond à cinq
// mille lignes. À douze mille neuf cent vingt-neuf représentants — un seul
// dépôt attendu — ce chemin ne tient plus, et à cent cinquante mille prospects
// il n'en est plus question.
//
// L'état vit donc ici, le processus le réclame par bail, et un balayage ramasse
// ce qu'un conteneur mort a laissé en plan. C'est le raisonnement déjà tenu par
// l'export intégral de la base : une minuterie en mémoire ne survit pas au
// redémarrage, l'état en base si.
//
// UNE SEULE TABLE, UN DISCRIMINANT. Représentants et prospects partagent le
// moteur — lecture en flux, tranches, reprise, rapport — et ne divergent que
// sur la validation d'une ligne. Une table par entité aurait dupliqué la
// machinerie, donc les corrections de la machinerie.

enum ImportKind {
  REPRESENTANTS
  PROSPECTS
}

/// `expired` n'est PAS un échec : le fichier et le rapport ont simplement passé
/// leur échéance. L'écran ne doit pas le présenter comme une erreur.
enum ImportStatus {
  queued
  running
  succeeded
  failed
  expired
}

/// `DRY_RUN` est le défaut côté service, comme pour l'import représentants
/// d'origine : un import qui écrit sans qu'on l'ait demandé est un incident.
enum ImportMode {
  DRY_RUN
  APPLY
}

model ImportJob {
  id     String       @id @default(uuid(7))
  kind   ImportKind
  status ImportStatus @default(queued)
  mode   ImportMode

  requestedById String
  requestedBy   User   @relation("ImportJobRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  fileName  String
  fileBytes Int

  /// Chemin sur disque, JAMAIS le contenu.
  ///
  /// Cent cinquante mille lignes en `bytea` entreraient dans chaque sauvegarde
  /// de la base et dans chaque export intégral, pour un fichier dont la durée
  /// de vie utile se compte en heures.
  storagePath String

  /// Connu après lecture de l'en-tête, donc nul tant que le travail n'a pas
  /// commencé. C'est le dénominateur de l'avancement.
  totalRows     Int?
  processedRows Int  @default(0)
  createdRows   Int  @default(0)
  skippedRows   Int  @default(0)
  errorRows     Int  @default(0)

  /// Erreurs bornées et aperçu, dans la forme que l'écran sait déjà lire.
  report      Json?
  failureCode String?
  failureMsg  String?

  /// Bail et jeton de fencing.
  ///
  /// Toute écriture du travailleur porte `claimToken` dans son `where` : une
  /// instance qui a perdu son bail ne peut plus rien écrire, même si elle
  /// l'ignore encore. C'est le motif de la revendication d'envoi des
  /// notifications, et il est repris tel quel.
  claimToken String?
  claimedAt  DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  /// Échéance du fichier déposé ET du rapport.
  expiresAt DateTime

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status, createdAt])
  @@index([requestedById, createdAt])
  /// Reprise des travaux morts : `queued` compte autant que `running`, la
  /// fenêtre entre les deux est étroite mais un conteneur peut y mourir.
  @@index([status, claimedAt])
  @@index([isDemo])
  @@map("import_jobs")
}

// ═════════════════════════════════════════════════════════════════════════════
// MIGRATION DE SEGMENT
// ═════════════════════════════════════════════════════════════════════════════
//
// LE SEGMENT N'EST PAS STOCKÉ, DONC SON CHANGEMENT NE LAISSE AUCUNE TRACE.
//
// BDD1..BDD4 se calculent par croisement du syndicat et de la banque. Faire
// passer un prospect de BDD3 à BDD1 revient donc à changer deux clés
// étrangères — deux `UPDATE`, et plus rien ensuite ne distingue une fiche
// convertie d'une fiche née en BDD1.
//
// Or convertir est le métier. Sans cette table, la question « combien de BDD3
// avons-nous fait basculer ce mois, et par qui » n'a pas de réponse, et elle
// n'en aura jamais rétroactivement.
//
// Écrite DANS LA MÊME TRANSACTION que la modification du prospect, comme les
// transitions de dossier bancaire : une trace écrite à côté finit un jour par
// mentir sur ce qu'elle prétend décrire.

enum ChangeSource {
  WEB
  MOBILE
}

model SegmentChange {
  id         String   @id @default(uuid(7))
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// Calculés de part et d'autre du changement. Stockés et non recalculés : la
  /// fonction de segmentation peut évoluer, l'histoire non.
  fromSegment BddSegment
  toSegment   BddSegment

  fromBanqueId   String
  toBanqueId     String
  fromSyndicatId String
  toSyndicatId   String

  /// Pourquoi, en clair. Une bascule de segment n'est pas une correction de
  /// faute de frappe.
  reason String?

  changedById String
  changedBy   User         @relation("SegmentChangeChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  source      ChangeSource

  changedAt DateTime @default(now())
  isDemo    Boolean  @default(false)

  @@index([prospectId, changedAt])
  /// « Combien de conversions vers BDD1 sur la période. »
  @@index([toSegment, changedAt])
  /// Attribution : qui a converti quoi.
  @@index([changedById, changedAt])
  @@index([isDemo])
  @@map("segment_changes")
}

// Devenir ambassadeur est le métier : `Representant.relationStatus` ne dit que
// l'état d'aujourd'hui, et l'écraser efface la date à laquelle un représentant a
// basculé, et par qui. Sans cette table, « combien d'ambassadeurs gagnés cette
// semaine, et par qui » n'a pas de réponse, et n'en aura jamais rétroactivement.
model RepresentantRelationChange {
  id             String       @id @default(uuid(7))
  representantId String
  representant   Representant @relation(fields: [representantId], references: [id], onDelete: Cascade)

  /// Stockés et non recalculés : la règle de classement peut évoluer, l'histoire
  /// non.
  fromStatus RepresentantRelation
  toStatus   RepresentantRelation

  /// Pourquoi, en clair. Un refus se justifie, une promotion en ambassadeur aussi.
  reason String?

  changedById String
  changedBy   User         @relation("RepresentantRelationChangeChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  source      ChangeSource

  changedAt DateTime @default(now())
  isDemo    Boolean  @default(false)

  @@index([representantId, changedAt])
  /// « Combien de bascules vers AMBASSADEUR sur la période. »
  @@index([toStatus, changedAt])
  /// Attribution : qui a converti qui.
  @@index([changedById, changedAt])
  @@index([isDemo])
  @@map("representant_relation_changes")
}

/// Un representant qui refuse peut nommer un collegue a appeler a sa place.
///
/// Table dediee et surtout PAS une fiche `Representant` : `phoneE164` y porte un
/// index unique PARTIEL, si bien qu'une fiche « suggeree » reserverait le numero.
/// Le teleconseiller qui rencontrerait un jour cette personne pour de vrai
/// recevrait REPRESENTANT_PHONE_CONFLICT, et la fusion automatique du mobile ne
/// se declenche que sur une fiche qui lui appartient deja : le conflit serait
/// definitif, sans geste capable de le resoudre. `Representant.departementId`
/// est en outre NOT NULL, qu'il faudrait inventer pour un contact dont on ne
/// connait que le numero.
model RepresentantSuggestion {
  id String @id @default(uuid(7))

  /// QUI a donne le numero. C'est ce qui fait de la piste autre chose qu'un numero nu.
  sourceRepresentantId String
  sourceRepresentant   Representant @relation("RepresentantSuggestionSource", fields: [sourceRepresentantId], references: [id], onDelete: Cascade)

  suggestedName String?

  /// Normalise par le SERVEUR, sans aucune unicite : deux representants qui citent
  /// le meme contact disent qu'il faut l'appeler en priorite, pas qu'il y a doublon.
  suggestedPhoneE164 String

  note String?

  suggestedById String
  suggestedBy   User   @relation("RepresentantSuggestionSuggestedBy", fields: [suggestedById], references: [id], onDelete: Restrict)

  /// Rempli quand le numero est deja une fiche vivante : la piste est deja connue.
  resolvedRepresentantId String?
  resolvedRepresentant   Representant? @relation("RepresentantSuggestionResolved", fields: [resolvedRepresentantId], references: [id], onDelete: SetNull)

  /// La tentative pendant laquelle la suggestion a ete recueillie. Son identifiant
  /// est la cle d'idempotence du client : l'unicite rend le rejeu sans effet, sans
  /// compter les lignes au prealable. Meme mecanisme que `ScheduledCallback.sourceAttemptId`.
  sourceAttemptId String         @unique
  sourceAttempt   RepCallAttempt @relation(fields: [sourceAttemptId], references: [id], onDelete: Cascade)

  status SuggestionStatus @default(A_APPELER)

  clientCreatedAt DateTime
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  /// Ligne appartenant au jeu de démonstration. Voir `User.isDemo`.
  isDemo Boolean @default(false)

  @@index([suggestedPhoneE164])
  @@index([sourceRepresentantId, createdAt])
  @@index([status, createdAt])
  @@index([isDemo])
  @@map("representant_suggestions")
}

enum SuggestionStatus {
  A_APPELER
  APPELE
  ABANDONNE
}
