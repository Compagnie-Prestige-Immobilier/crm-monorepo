{
  "extends": "./base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    // Bundler resolution emits extensionless specifiers, which bare Node ESM
    // cannot resolve. The API runs on plain Node, so it needs NodeNext and
    // explicit .js extensions on relative imports.
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "exclude": ["dist", "node_modules"]
}
