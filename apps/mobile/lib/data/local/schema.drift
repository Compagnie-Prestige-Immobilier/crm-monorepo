-- Schéma local de CPI GO : miroir hors ligne de packages/database/prisma/schema.prisma.
--
-- Écrit en SQL et non en tables Dart, pour trois raisons qui sont toutes des
-- contraintes du serveur qu'on doit reproduire au caractère près :
--   1. l'index UNIQUE **partiel** (`WHERE deleted_at IS NULL`) n'est pas
--      exprimable dans le DSL Dart de drift ;
--   2. `ON UPDATE CASCADE` sur prospects.representant_id est porteur (voir plus
--      bas) et doit apparaître tel quel dans le DDL ;
--   3. les vues dérivent `sync_status` par jointure sur l'outbox : c'est du SQL,
--      pas un modèle objet.
--
-- Les identifiants sont des UUID v7 générés PAR LE CLIENT. C'est ce qui rend la
-- saisie hors ligne possible : un prospect peut pointer vers son représentant
-- avant que l'un ou l'autre n'ait jamais vu le serveur.

-- ─────────────────────────────────────────────────────────────────────────────
-- Référentiels : tirés du serveur, jamais écrits localement
-- ─────────────────────────────────────────────────────────────────────────────

CREATE TABLE departements (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    region_id TEXT NOT NULL,
    -- Libellé dénormalisé, même patron que `iefs.departement_name` : le
    -- sélecteur en cascade doit nommer la région SANS réseau, et il n'existe pas
    -- de table `regions` en local.
    --
    -- Vide par défaut : les bases déjà installées portent des départements que
    -- le pull ne redescendra qu'après la remise à zéro du curseur (palier v8).
    -- Tant qu'elle est vide, l'étape « Région » se masque.
    region_name TEXT NOT NULL DEFAULT '',
    is_active BOOLEAN NOT NULL DEFAULT 1,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX departements_active_idx ON departements (is_active, name);

CREATE INDEX departements_region_idx ON departements (region_id, name);

-- Les IEF : Inspections de l'Éducation et de la Formation.
--
-- Découpage SCOLAIRE, distinct du découpage administratif : 59 IEF pour
-- 46 départements, et quatre IEF dans le seul département de Dakar. Les
-- feuilles de route sont bâties dessus, donc c'est ce que le téléconseiller a
-- sous les yeux quand il saisit.
--
-- Répliquée en local comme les autres référentiels : le sélecteur doit
-- fonctionner sans réseau, sinon la saisie s'arrête dès que la connexion tombe.
CREATE TABLE iefs (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    departement_id TEXT NOT NULL REFERENCES departements (id) ON UPDATE CASCADE,
    departement_name TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX iefs_active_idx ON iefs (is_active, departement_name, name);
CREATE INDEX iefs_departement_idx ON iefs (departement_id);

CREATE TABLE banques (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    short_name TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX banques_active_idx ON banques (is_active, sort_order, name);

CREATE TABLE syndicats (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sigle TEXT NOT NULL,
    secteur TEXT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX syndicats_active_idx ON syndicats (is_active, sort_order, name);

-- Par où le prospect est arrivé. Référentiel ouvert, administré depuis le web.
CREATE TABLE canaux_provenance (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX canaux_provenance_active_idx
    ON canaux_provenance (is_active, sort_order, label);

-- Les tranches de revenu mensuel, administrées depuis le web. Les bornes
-- descendent avec la ligne mais ne servent qu'à relire le libellé : c'est le
-- serveur qui juge la cohérence d'une tranche citée par une saisie.
CREATE TABLE income_bands (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    min_xof INTEGER NULL,
    max_xof INTEGER NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX income_bands_active_idx
    ON income_bands (is_active, sort_order, label);

-- Le référentiel des professions, administré depuis le web. Sans lui en local,
-- le mobile ne pouvait qu'écrire la profession en clair pendant que le web la
-- choisissait dans la liste : deux vérités pour la même fiche.
CREATE TABLE professions (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    is_teaching BOOLEAN NOT NULL DEFAULT 0,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX professions_active_idx
    ON professions (is_active, sort_order, label);

-- Ministères et entreprises, administrés depuis le web. `type` sépare les deux
-- listes proposées au fonctionnaire et au salarié du privé.
--
-- Pas de CHECK sur `type` : la valeur vient du SERVEUR, comme partout ailleurs,
-- et un quatrième type ajouté côté serveur avorterait la page de pull entière.
CREATE TABLE employeurs (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    type TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE INDEX employeurs_active_idx
    ON employeurs (type, is_active, sort_order, label);

-- Pays de résidence de la diaspora. `indicatif` est l'indicatif téléphonique
-- SANS le « + » : il pré-remplit le champ international du prospect.
CREATE TABLE pays (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    indicatif TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
-- Nommée : le singulier que drift déduirait de « pays » est « Pay ».
) AS PaysRow;

CREATE INDEX pays_active_idx ON pays (is_active, sort_order, label);

-- Les quatre listes du registre des visites, dans UNE table : elles ont la même
-- forme, et `kind` suffit à les séparer. Quatre tables jumelles auraient quatre
-- fois le même code de pull et de lecture.
--
-- Sans elles en local, le formulaire d'inscription appelait l'API à chaque
-- ouverture : le registre se LISAIT hors ligne, il ne se REMPLISSAIT pas.
--
-- Pas de CHECK sur `kind` : la valeur vient du SERVEUR, comme partout ailleurs.
CREATE TABLE visite_referentiels (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL
);

CREATE INDEX visite_referentiels_kind_idx
    ON visite_referentiels (kind, is_active, sort_order, label);

-- Motifs d'issue d'appel, administrés depuis le web par l'équipe du client.
--
-- `code` est la clé primaire et il est IMMUABLE côté serveur : les tentatives
-- déjà remontées le référencent.
--
-- Pas de CHECK sur `effect`, même raison que `prospects.statut` : la valeur
-- vient du SERVEUR et un CHECK figé ferait avorter la transaction de pull
-- entière le jour où un sixième effet apparaît.
CREATE TABLE call_outcome_reasons (
    code TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    effect TEXT NOT NULL,
    requires_comment BOOLEAN NOT NULL DEFAULT 0,
    requires_callback BOOLEAN NOT NULL DEFAULT 0,
    counts_as_reached BOOLEAN NOT NULL DEFAULT 0,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 100,
    color TEXT NULL,
    -- Le serveur ne redescend que les motifs dont cette valeur est inférieure ou
    -- égale à la version de charge utile demandée : un motif reçu ici est donc
    -- toujours émettable par cette application.
    min_payload_version INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX call_outcome_reasons_active_idx
    ON call_outcome_reasons (is_active, sort_order, label);

-- Statuts de qualification d'un représentant, administrés depuis le web.
--
-- `effect` dit à la fois l'issue à enregistrer et la branche du script où le
-- statut se propose : pas de colonne « joignable », qui serait une seconde
-- vérité. Mêmes raisons qu'au-dessus pour l'absence de CHECK.
--
-- `position` est le rang servi par la route : l'ordre d'affichage se décide au
-- serveur et ne redescend pas autrement.
CREATE TABLE statuts_qualification (
    code TEXT NOT NULL PRIMARY KEY,
    id TEXT NOT NULL,
    label TEXT NOT NULL,
    effect TEXT NOT NULL,
    requires_callback BOOLEAN NOT NULL DEFAULT 0,
    -- Délai du réessai proposé (minutes). NULL : aucun réessai.
    retry_after_minutes INTEGER NULL,
    is_active BOOLEAN NOT NULL DEFAULT 1,
    position INTEGER NOT NULL DEFAULT 0,
    min_payload_version INTEGER NOT NULL DEFAULT 6
) AS StatutQualificationRow;

CREATE INDEX statuts_qualification_active_idx
    ON statuts_qualification (is_active, position, label);

-- ─────────────────────────────────────────────────────────────────────────────
-- Métier
-- ─────────────────────────────────────────────────────────────────────────────

CREATE TABLE representants (
    id TEXT NOT NULL PRIMARY KEY,
    full_name TEXT NOT NULL,
    -- Téléphone normalisé E.164. Clé de déduplication métier ; la normalisation
    -- doit être IDENTIQUE ici et côté serveur, sinon la contrainte devient
    -- aléatoire d'un appareil à l'autre.
    phone_e164 TEXT NOT NULL,
    notes TEXT NULL,
    departement_id TEXT NOT NULL REFERENCES departements (id) ON UPDATE CASCADE,
    -- IEF de rattachement, FACULTATIVE. Les fiches saisies avant l'arrivée de ce
    -- référentiel n'en portent pas ; une colonne obligatoire les rendrait
    -- invalides et bloquerait leur synchronisation.
    ief_id TEXT NULL REFERENCES iefs (id) ON UPDATE CASCADE,
    -- Écrite par le SERVEUR, jamais depuis le terrain, et donc SANS CHECK
    -- d'énumération : même raison que `prospects.statut` et
    -- `phase2_directory.phase2_status`, une valeur ajoutée côté serveur ferait
    -- avorter la page de pull entière.
    relation_status TEXT NOT NULL DEFAULT 'INCONNU',
    -- Le libellé visible de la fiche, comme sur le web. Sans REFERENCES : le
    -- référentiel se peuple par sa propre route, la fiche peut arriver avant.
    statut_qualification_id TEXT NULL,
    -- Trois états et non un booléen, et SANS CHECK pour la même raison que
    -- `relation_status` : rien d'autre ne distingue « il n'a pas WhatsApp » de
    -- « la question ne lui a pas été posée ».
    whatsapp_status TEXT NOT NULL DEFAULT 'NON_DEMANDE',
    -- Renseigné UNIQUEMENT sur `AUTRE_NUMERO`. Sur `MEME_NUMERO` le numéro
    -- n'est PAS recopié : `phone_e164` se corrige, la copie divergerait sans
    -- que rien ne le signale.
    whatsapp_e164 TEXT NULL,
    profession TEXT NULL,
    -- Renseignements du script de qualification. Tous FACULTATIFS : une fiche
    -- d'avant ce script n'en porte aucun, et la question peut ne pas avoir été
    -- posée. Écrits à la saisie ET au pull, comme le reste de la fiche.
    prenom TEXT NULL,
    etablissement TEXT NULL,
    syndicat TEXT NULL,
    -- Tri-état : 1 oui, 0 non, NULL question non posée : même patron que
    -- `call_attempts.fonctionnaire`.
    connait_ues BOOLEAN NULL,
    contacte BOOLEAN NULL,
    -- Dernier appel consigné, tel que le SERVEUR le résume. SANS CHECK, même
    -- raison que `relation_status` : une issue ajoutée côté serveur ferait
    -- avorter la page de pull entière.
    last_call_outcome TEXT NULL,
    last_call_at DATETIME NULL,
    last_call_by_id TEXT NULL,
    call_attempt_count INTEGER NOT NULL DEFAULT 0,
    next_callback_at DATETIME NULL,
    created_by_id TEXT NOT NULL,
    -- Horodatage de la saisie sur le terrain, distinct de l'arrivée en base :
    -- les deux peuvent être séparés de plusieurs jours hors ligne.
    client_created_at DATETIME NOT NULL,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

-- Index UNIQUE **partiel**, copie conforme du serveur. Un `UNIQUE` ordinaire
-- réserverait le numéro à vie après une suppression logique : le commercial
-- supprime une fiche saisie par erreur, puis ne peut plus jamais ressaisir ce
-- numéro, sans message compréhensible.
CREATE UNIQUE INDEX representants_phone_unique
    ON representants (phone_e164) WHERE deleted_at IS NULL;

CREATE INDEX representants_departement_idx ON representants (departement_id);
CREATE INDEX representants_created_idx ON representants (client_created_at DESC);

CREATE TABLE prospects (
    id TEXT NOT NULL PRIMARY KEY,
    nom TEXT NOT NULL,
    prenom TEXT NOT NULL,
    phone_e164 TEXT NOT NULL,
    -- FACULTATIFS. Un teleconseiller au telephone ne les obtient pas toujours,
    -- et une fiche Grand Public n'en a aucun : les exiger faisait abandonner la
    -- saisie entiere. Le segment BDD1-4 vaut alors « aucun », il ne se devine pas.
    banque_id TEXT REFERENCES banques (id) ON UPDATE CASCADE,
    syndicat_id TEXT REFERENCES syndicats (id) ON UPDATE CASCADE,
    -- ON UPDATE CASCADE est PORTEUR, pas décoratif. Quand un représentant saisi
    -- hors ligne s'avère être un doublon d'une fiche déjà en base, la résolution
    -- consiste à réécrire l'identifiant local vers l'identifiant serveur. La
    -- cascade fait suivre tous les prospects rattachés en UNE instruction, au
    -- lieu d'une boucle de rattrapage manuelle qui laisserait des orphelins si
    -- elle était interrompue.
    representant_id TEXT
        REFERENCES representants (id) ON UPDATE CASCADE ON DELETE RESTRICT,
    created_by_id TEXT NOT NULL,
    -- Pas de CHECK d'énumération : la valeur vient du SERVEUR, par le pull.
    -- Un `ProspectStatut` ajouté côté serveur arrive en `unknown_default_open_api`
    -- (c'est le rôle d'`enumUnknownDefaultCase: true` dans openapi-config.yaml)
    -- et un CHECK figé ABORTAIT la transaction de pull entière : la page était
    -- perdue, le curseur n'avançait pas, et la synchronisation s'arrêtait sur
    -- une valeur que ce client n'avait pas à comprendre pour la stocker.
    -- Pas de CHECK : la valeur vient du SERVEUR. Voir `statut` juste dessous.
    projet TEXT NOT NULL DEFAULT 'CHUES',
    type TEXT,
    profession TEXT,
    -- La profession choisie au référentiel. `profession` reste le repli en clair
    -- pour l'informel, que la liste ne couvrira jamais.
    profession_id TEXT,
    duree_systeme_mois INTEGER,
    -- Pas de REFERENCES : le canal descend du serveur par le pull, et une fiche
    -- saisie hors ligne ne doit pas attendre que son referentiel soit arrive.
    canal_provenance_id TEXT,
    income_band_id TEXT,
    -- Les renseignements propres à la situation du prospect Grand Public. Tous
    -- FACULTATIFS : une situation ne les demande pas tous, et rien de neuf ne
    -- doit rendre une saisie de terrain impossible à enregistrer.
    --
    -- Ni REFERENCES ni CHECK, pour les deux raisons déjà écrites plus haut : le
    -- référentiel peut n'être pas encore descendu, et une énumération élargie
    -- côté serveur avorterait la page de pull entière.
    employeur_id TEXT,
    -- Le repli en clair quand l'employeur n'est pas au référentiel. Au pull, le
    -- serveur y remet le libellé résolu.
    employeur TEXT,
    type_contrat TEXT,
    anciennete_mois INTEGER,
    lieu_activite TEXT,
    mode_epargne TEXT,
    pays_residence_id TEXT,
    ville_residence TEXT,
    whatsapp_e164 TEXT,
    relais_nom TEXT,
    relais_phone_e164 TEXT,
    -- Dernier appel consigné, écrit par le SERVEUR au pull et, hors ligne, par
    -- la saisie locale. SANS CHECK, même raison que `statut` : une issue ajoutée
    -- côté serveur ferait avorter la page de pull entière.
    last_call_outcome TEXT NULL,
    last_call_at DATETIME NULL,
    last_call_by_id TEXT NULL,
    call_attempt_count INTEGER NOT NULL DEFAULT 0,
    statut TEXT NOT NULL DEFAULT 'NOUVEAU',
    client_created_at DATETIME NOT NULL,
    rev INTEGER NOT NULL DEFAULT 1,
    local_updated_at DATETIME NOT NULL,
    server_updated_at DATETIME NULL,
    deleted_at DATETIME NULL
);

CREATE UNIQUE INDEX prospects_phone_unique
    ON prospects (phone_e164) WHERE deleted_at IS NULL;

CREATE INDEX prospects_representant_idx ON prospects (representant_id);
CREATE INDEX prospects_created_idx ON prospects (client_created_at DESC);

-- Les projets qu'une fiche a rejoints. Le serveur classe par PARCOURS, pas par
-- la colonne `projet` : celle-ci ne dit que par où la fiche est entrée, et un
-- même numéro peut suivre CHUES et Grand Public en même temps. Filtrer sur
-- `projet` retirait la fiche du premier projet dès qu'elle rejoignait l'autre.
--
-- Ecrite AUSSI a la saisie, pas seulement au pull : hors ligne, une fiche doit
-- apparaitre dans la liste de son projet avant tout aller-retour serveur.
--
-- Pas de `rev` : un parcours s'ouvre, il ne se modifie pas depuis le telephone.
-- Pas de CHECK sur `projet` ni `statut` : la valeur vient du SERVEUR, et un
-- CHECK fige avorterait la transaction de pull entiere sur un projet ajoute
-- apres coup.
CREATE TABLE prospect_journeys (
    prospect_id TEXT NOT NULL
        REFERENCES prospects (id) ON UPDATE CASCADE ON DELETE CASCADE,
    projet TEXT NOT NULL,
    statut TEXT NOT NULL DEFAULT 'NOUVEAU',
    PRIMARY KEY (prospect_id, projet)
);

CREATE INDEX prospect_journeys_projet_idx ON prospect_journeys (projet);

-- Fil de commentaires d'un représentant.
--
-- Seule table métier SANS `rev`, et c'est structurel : un commentaire s'AJOUTE,
-- il ne se modifie ni ne s'efface. Rien à arbitrer, donc rien à versionner. Deux
-- téléconseillers hors ligne qui commentent la même fiche produisent deux lignes
-- distinctes, jamais une fusion, et le serveur ne peut pas rendre de conflit de
-- révision sur une écriture qui n'en annonce aucune.
--
-- `id` est un UUID v7 engendré par le client : c'est la clé d'idempotence, la
-- même mécanique que `call_attempts`.
--
-- Pas de CHECK sur `body` : c'est du texte libre, et le seul champ du produit où
-- la saisie au clavier est légitime.
CREATE TABLE representant_comments (
    id TEXT NOT NULL PRIMARY KEY,
    representant_id TEXT NOT NULL
        REFERENCES representants (id) ON UPDATE CASCADE ON DELETE CASCADE,
    author_id TEXT NOT NULL,
    -- Nom dénormalisé : le fil doit nommer son auteur SANS réseau, et il
    -- n'existe pas de table d'utilisateurs en local.
    author_name TEXT NOT NULL,
    body TEXT NOT NULL,
    client_created_at DATETIME NOT NULL,
    -- Nul tant que le serveur n'a pas accusé réception.
    server_created_at DATETIME NULL
);

CREATE INDEX representant_comments_representant_idx
    ON representant_comments (representant_id, client_created_at DESC);

-- ─────────────────────────────────────────────────────────────────────────────
-- Mécanique de synchronisation
-- ─────────────────────────────────────────────────────────────────────────────

-- File d'attente d'écriture. Toute écriture métier passe par ici : la base
-- locale est la source de vérité tant que le lot n'a pas été accepté.
--
-- `seq` est la clé primaire AUTOINCREMENT et non `id`, parce que SQLite ne
-- permet AUTOINCREMENT que sur un INTEGER PRIMARY KEY. C'est la seule écriture
-- possible de « id TEXT + seq monotone » : `id` reste la clé logique (UNIQUE) et
-- `seq` garantit un ordre d'émission strictement croissant et jamais réutilisé,
-- y compris après purge des lignes terminées.
CREATE TABLE outbox (
    seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    -- Deux opérations qui partagent une dependency_key doivent partir dans
    -- l'ordre de `seq` : c'est ce qui garantit qu'un prospect n'est jamais
    -- poussé avant le représentant dont il dépend.
    dependency_key TEXT NULL,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    op TEXT NOT NULL CHECK (op IN ('create', 'update', 'delete')),
    payload TEXT NOT NULL,
    -- Version du format de `payload`. Une app restée hors ligne trois semaines
    -- peut avoir empilé des opérations dans un format que le code courant ne
    -- produit plus ; sans ce numéro on ne saurait pas les relire.
    payload_version INTEGER NOT NULL DEFAULT 1,
    -- `rev` connue au moment de la mise en file. Le serveur refuse l'écriture si
    -- sa propre `rev` a bougé entre-temps : c'est la détection de conflit.
    base_rev INTEGER NULL,
    status TEXT NOT NULL DEFAULT 'pending'
        CHECK (status IN ('pending', 'syncing', 'done', 'conflict', 'failed')),
    -- Tentatives dont le SERVEUR est responsable : refus, 5xx, absence de
    -- verdict. Ce sont elles, et elles seules, qui mènent à `failed` par
    -- épuisement.
    attempts INTEGER NOT NULL DEFAULT 0,
    -- Tentatives BLOQUÉES : le serveur a répondu, mais l'opération n'a pas été
    -- jugée (dépendance non résolue, statut inconnu). Compteur séparé pour deux
    -- raisons qui sont deux bugs distincts :
    --   1. brûler `attempts` pour la faute d'une AUTRE opération tuerait une
    --      saisie parfaitement valide ;
    --   2. ne rien compter du tout laissait `attempts` à zéro, donc un délai de
    --      back-off nul, donc cinquante réémissions par vidange, toutes les
    --      soixante secondes, indéfiniment, sans jamais devenir visible dans
    --      « À corriger ».
    -- Il porte donc son propre plancher (30 s) et son propre plafond, au terme
    -- duquel la ligne passe en `failed` et devient actionnable.
    blocked_attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at DATETIME NOT NULL,
    -- Bail pris par l'isolat qui traite la ligne. Sans bail, l'isolat WorkManager
    -- et l'isolat UI peuvent envoyer la même opération deux fois.
    lease_until DATETIME NULL,
    -- Jeton de possession, écrit dans la MÊME instruction que le bail.
    --
    -- Le bail seul dit « quelqu'un travaille sur cette ligne » ; il ne dit pas
    -- QUI. Toutes les écritures d'après-envoi (verdict, remise en file, échec,
    -- réparation d'horloge, récupération de bail) désignaient la ligne par son
    -- seul `seq`. Un isolat dont le bail a expiré pendant qu'il attendait le
    -- réseau revenait donc écrire son verdict sur une ligne qu'un AUTRE isolat
    -- avait déjà reprise et renvoyée : le verdict du premier envoi écrasait
    -- l'état du second, et une opération réellement en attente passait `done`.
    --
    -- Le jeton rend chaque écriture conditionnelle : `WHERE seq = ? AND
    -- claim_token = ?`. Un écrivain qui n'est plus le propriétaire ne met à jour
    -- aucune ligne, ce qui est exactement le comportement voulu : ne rien faire,
    -- pas écraser. Il est remis à NULL dès que la ligne est relâchée.
    claim_token TEXT NULL,
    batch_id TEXT NULL,
    last_error_code TEXT NULL,
    last_error_msg TEXT NULL,
    created_at DATETIME NOT NULL
);

-- Index de sélection du prochain lot. L'ordre des colonnes suit exactement
-- l'ordre du WHERE + ORDER BY du sélecteur d'outbox.
CREATE INDEX outbox_ready_idx
    ON outbox (status, next_attempt_at, dependency_key, seq);

CREATE INDEX outbox_entity_idx ON outbox (entity_type, entity_id, status);

-- Brouillons de formulaire. Distincts de l'outbox : un brouillon n'est PAS une
-- intention d'écriture, c'est une saisie inachevée qu'on ne veut pas perdre si
-- l'app est tuée par le système au milieu d'un formulaire.
CREATE TABLE form_drafts (
    draft_id TEXT NOT NULL PRIMARY KEY,
    form_key TEXT NOT NULL,
    entity_id TEXT NULL,
    parent_id TEXT NULL,
    payload TEXT NOT NULL,
    step INTEGER NOT NULL DEFAULT 0,
    schema_version INTEGER NOT NULL DEFAULT 1,
    updated_at DATETIME NOT NULL
);

CREATE INDEX form_drafts_key_idx ON form_drafts (form_key, updated_at DESC);

-- Curseur de pull par collection (keyset sur (updated_at, id) côté serveur).
CREATE TABLE sync_state (
    collection TEXT NOT NULL PRIMARY KEY,
    cursor TEXT NULL,
    last_pulled_at DATETIME NULL
);

-- Le périmètre d'appel du compte connecté, REMPLACÉ en entier à chaque pull.
--
-- Le pull de synchronisation est global : c'est le téléphone qui borne ce qu'un
-- téléconseiller voit et appelle. `kind = 'borne'` est le marqueur du
-- périmètre : posé seulement quand le serveur répond `tout: false`. Son ABSENCE
-- vaut « aucun filtre », ce qui couvre à la fois l'encadrement et l'appareil qui
-- n'a pas encore lu ses attributions : tout cacher avant la première lecture
-- serait pire que d'en montrer trop.
CREATE TABLE attributions (
    kind TEXT NOT NULL CHECK (kind IN ('representant', 'prospect', 'borne')),
    id TEXT NOT NULL,
    PRIMARY KEY (kind, id)
);

-- ─────────────────────────────────────────────────────────────────────────────
-- Phase 2 : annuaire d'enrôlement
-- ─────────────────────────────────────────────────────────────────────────────

-- SIX COLONNES, JAMAIS UNE DE PLUS. C'est une frontière de confidentialité, pas
-- une préférence de modélisation.
--
-- Cette table est répliquée sur le téléphone PERSONNEL de chaque commercial,
-- hors ligne, et couvre l'intégralité du portefeuille : 50 000 à 500 000 lignes.
-- Y ajouter le nom, la banque ou le syndicat reviendrait à distribuer la base
-- nominative complète à chaque terminal : une seule perte d'appareil suffirait
-- à la faire fuiter. Le commercial n'a besoin que de savoir quel numéro il
-- vient de composer et si le dossier est déjà réglé : le programme papier, lui,
-- ne porte que des numéros, délibérément.
--
-- Un test compare l'ensemble des colonnes à cette liste exacte : ajouter un
-- champ ici doit être un acte délibéré qui casse ce test.
--
-- Pas de `local_updated_at` ni de `server_updated_at` comme sur les tables
-- métier : rien n'est jamais écrit ici depuis le terrain à part le miroir
-- optimiste d'une issue terminale, et `rev` suffit à arbitrer un pull rejoué.
CREATE TABLE phase2_directory (
    prospect_id TEXT NOT NULL PRIMARY KEY,
    -- Téléphone normalisé E.164, normalisé EXACTEMENT comme le serveur. C'est
    -- la seule clé de recherche de l'écran : la saisie est comparée en égalité
    -- stricte après normalisation, jamais en `LIKE`. Un `LIKE '%…%'` sur
    -- 500 000 lignes n'utilise aucun index et prend des secondes sur un
    -- téléphone d'entrée de gamme : soit, à l'échelle d'une pile d'appels, une
    -- minute perdue toutes les vingt recherches.
    phone_e164 TEXT NOT NULL,
    -- Aucun CHECK d'énumération sur ces deux colonnes : elles sont ÉCRITES PAR
    -- LE SERVEUR, page par page, par `Phase2DirectorySync`. Une quatrième
    -- méthode d'enrôlement ajoutée côté serveur faisait échouer l'écriture de la
    -- page entière : 2000 lignes perdues, curseur figé, annuaire jamais complet
    -- : exactement ce que `enumUnknownDefaultCase: true` existe pour éviter.
    --
    -- Le vocabulaire vit maintenant dans `Phase2Statuses` et
    -- `EnrollmentMethods`, dérivés de l'énumération générée : une seule
    -- définition, qui suit le contrat au lieu de le figer.
    phase2_status TEXT NOT NULL DEFAULT 'PENDING',
    -- Renseignée si et seulement si `phase2_status` vaut METHOD_OBTAINED, comme
    -- côté serveur.
    enrollment_method TEXT NULL,
    rev INTEGER NOT NULL DEFAULT 1,
    updated_at DATETIME NOT NULL
);

-- UNIQUE et non un simple index : le serveur garantit un numéro par prospect,
-- et un doublon local ferait rendre à la recherche exacte deux lignes
-- contradictoires : l'écran devrait alors choisir, ce qu'il ne peut pas faire.
-- Pas d'index partiel ici : l'annuaire n'a pas de suppression logique, une
-- ligne retirée du périmètre disparaît au pull suivant.
CREATE UNIQUE INDEX phase2_directory_phone_unique ON phase2_directory (phone_e164);

CREATE INDEX phase2_directory_status_idx ON phase2_directory (phase2_status);

-- Tentatives d'appel saisies sur CE téléphone.
--
-- Distincte de l'outbox : l'outbox décrit une intention d'écriture et se vide,
-- alors que cette table est le journal de ce que le commercial a réellement
-- saisi. C'est elle qui alimente sa progression personnelle, y compris pour des
-- lignes déjà acquittées par le serveur.
--
-- Les trois CHECK restants reproduisent les contraintes de FORME de
-- `call_attempts` côté PostgreSQL : « méthode si et seulement si le motif ferme
-- sur une méthode », « un motif qui exige un commentaire l'obtient »,
-- « commentaire borné ». Ce sont des règles structurelles, pas des listes de
-- vocabulaire : elles s'expriment sur l'EFFET et sur l'exigence recopiés du
-- motif, donc elles restent vraies quel que soit le motif que l'équipe du
-- client ajoutera demain depuis le web.
--
-- Les répliquer ici n'est pas de la ceinture et des bretelles : sans elles, une
-- saisie invalide s'enregistre sur le terrain, part dans la file, et n'est
-- refusée qu'à la synchronisation : c'est-à-dire potentiellement trois semaines
-- plus tard, à un moment où le commercial ne se souvient plus de l'appel et ne
-- peut plus rien corriger.
CREATE TABLE call_attempts (
    -- UUID v7 engendré par le client. C'est la clé d'idempotence du serveur.
    id TEXT NOT NULL PRIMARY KEY,
    prospect_id TEXT NOT NULL,
    -- Issue historique, énumération FERMÉE du contrat : c'est elle que lisent
    -- les versions du serveur qui ignorent encore les motifs. Conservée telle
    -- quelle, sans liste dans le DDL : la retirer rendrait illisibles les
    -- tentatives déjà en file.
    outcome TEXT NOT NULL,
    -- Motif choisi, code du référentiel serveur. Nul sur les tentatives d'avant
    -- la v10, qui n'en portaient pas.
    reason_code TEXT NULL,
    -- Effet du motif AU MOMENT DE LA SAISIE. Recopié et non joint : SQLite
    -- n'admet pas de sous-requête dans un CHECK, et un motif reconfiguré plus
    -- tard ne doit pas invalider rétroactivement une tentative déjà saisie.
    effect TEXT NOT NULL DEFAULT 'KEEP_OPEN',
    requires_comment BOOLEAN NOT NULL DEFAULT 0,
    method TEXT NULL,
    comment TEXT NULL,
    -- Heure du rappel demandé, FACULTATIVE même sur CALLBACK. Aucun CHECK ne la
    -- lie à l'issue : les versions déjà déployées enregistrent des « À rappeler »
    -- sans date, et un `CHECK ((outcome = 'CALLBACK') = (callback_at IS NOT NULL))`
    -- ferait échouer leur INSERT LOCAL, hors ligne, sur le terrain.
    callback_at DATETIME NULL,
    -- Renseignements recueillis PENDANT l'appel de conversion. Nuls sur toute
    -- tentative saisie avant la v19, et nuls sur une tentative où la question
    -- n'a pas été posée : c'est la même chose du point de vue du dossier.
    email TEXT NULL,
    -- Tri-état : 1 oui, 0 non, NULL question non posée. Un booléen NON NUL
    -- aurait fait passer 12 929 fiches pour « non fonctionnaire ».
    fonctionnaire BOOLEAN NULL,
    engagement_en_cours BOOLEAN NULL,
    -- Ancienneté DANS L'ÉTABLISSEMENT, en mois. Distincte de
    -- `prospects.duree_systeme_mois`, qui est la durée du système de paiement.
    duree_etablissement_mois INTEGER NULL,
    rendez_vous_at DATETIME NULL,
    client_created_at DATETIME NOT NULL,
    created_by_id TEXT NOT NULL,
    -- Méthode si et seulement si le motif ferme sur une méthode obtenue.
    CHECK ((effect = 'CLOSE_METHOD') = (method IS NOT NULL)),
    -- Un motif qui exige un commentaire l'obtient, non vide.
    CHECK (requires_comment = 0 OR (comment IS NOT NULL AND length(trim(comment)) > 0)),
    CHECK (comment IS NULL OR length(comment) <= 2000),
    CHECK (email IS NULL OR length(email) <= 160),
    CHECK (duree_etablissement_mois IS NULL
        OR (duree_etablissement_mois BETWEEN 0 AND 600)),
    -- Date de rendez-vous si et seulement si la méthode est la prise de
    -- rendez-vous, comme côté serveur. `COALESCE` et non `method =` : sur une
    -- méthode nulle la comparaison rend NULL, et un CHECK NULL laisse passer.
    CHECK ((COALESCE(method, '') = 'APPOINTMENT') = (rendez_vous_at IS NOT NULL))
);

CREATE INDEX call_attempts_prospect_idx
    ON call_attempts (prospect_id, client_created_at DESC);

CREATE INDEX call_attempts_created_idx ON call_attempts (client_created_at DESC);

-- ── Notifications push ───────────────────────────────────────────────────────

-- Centre de notifications, en local.
--
-- Pourquoi dupliquer ici ce que l'API sait rendre : l'application est hors
-- ligne par conception. Un commercial qui ouvre son centre de notifications
-- dans une zone sans réseau doit y trouver ce qu'il a reçu, pas un indicateur
-- de chargement. La liste est servie depuis SQLite ; l'API ne fait que la
-- compléter quand elle est joignable.
--
-- `id` est l'identifiant SERVEUR de la notification, et c'est ce qui rend
-- l'insertion idempotente : FCM remet volontiers deux fois le même message
-- après une reprise de connexion, et deux lignes fausseraient le compteur de
-- non-lues.
CREATE TABLE notifications (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'ANNONCE',
    -- Route interne ouverte au tap. Déjà validée à l'entrée : une valeur qui
    -- n'est pas une route interne est effacée avant d'arriver ici, jamais
    -- conservée « au cas où ».
    route TEXT NULL,
    payload TEXT NULL,
    -- Non nul dès la première lecture, et jamais réécrit ensuite : une
    -- notification relue ne redevient pas neuve.
    read_at DATETIME NULL,
    -- Horodatage d'ENVOI (serveur), qui gouverne l'ordre d'affichage.
    created_at DATETIME NOT NULL,
    -- Horodatage de RÉCEPTION sur cet appareil. Distinct du précédent : les
    -- deux peuvent être séparés de plusieurs heures si le téléphone était
    -- éteint, et l'ordre doit rester celui de l'envoi.
    received_at DATETIME NOT NULL
-- `AS StoredNotification` : sans ce renommage, drift engendrerait une classe
-- `Notification`, qui entre en collision avec la `Notification` de
-- `package:flutter/widgets.dart` dans tout écran qui importe Material. La
-- collision ne se voit pas ici mais trois fichiers plus loin, sous forme d'une
-- erreur de type incompréhensible.
) AS StoredNotification;

CREATE INDEX notifications_created_idx ON notifications (created_at);

-- Sert la pastille de non-lues, qui est relue à chaque changement de la table.
CREATE INDEX notifications_unread_idx ON notifications (read_at);

-- ─────────────────────────────────────────────────────────────────────────────
-- Vues : le statut de synchronisation est DÉRIVÉ, jamais stocké
-- ─────────────────────────────────────────────────────────────────────────────
--
-- Il serait tentant d'ajouter une colonne `sync_status` sur representants et
-- prospects. Elle se désynchroniserait de l'outbox la première fois qu'un chemin
-- de code oublierait de la mettre à jour : et ce chemin existe toujours (retry,
-- expiration de bail, purge). Ici la vue lit l'outbox : il n'y a rien à tenir
-- à jour, donc rien à oublier.
--
-- « Tête d'opération » = l'opération non terminée de plus petit `seq` pour
-- l'entité. C'est celle qui partira ensuite, donc celle qui décrit l'état
-- courant visible par l'utilisateur.

CREATE VIEW representant_sync_view AS
SELECT
    r.*,
    sq.label AS statut_qualification_label,
    sq.effect AS statut_qualification_effect,
    CASE
        WHEN o.status IS NOT NULL THEN o.status
        WHEN r.server_updated_at IS NULL THEN 'draft'
        ELSE 'synced'
    END AS sync_status
FROM representants AS r
LEFT JOIN statuts_qualification AS sq ON sq.id = r.statut_qualification_id
LEFT JOIN outbox AS o
    ON o.entity_type = 'representant'
    AND o.entity_id = r.id
    AND o.status IN ('pending', 'syncing', 'conflict', 'failed')
    AND o.seq = (
        SELECT MIN(o2.seq) FROM outbox AS o2
        WHERE o2.entity_type = 'representant'
          AND o2.entity_id = r.id
          AND o2.status IN ('pending', 'syncing', 'conflict', 'failed')
    );

CREATE VIEW prospect_sync_view AS
SELECT
    p.*,
    CASE
        -- `blocked` : le prospect lui-même va bien, mais son représentant est
        -- coincé. Le pousser maintenant produirait une clé étrangère orpheline
        -- côté serveur, donc l'UI doit le dire au lieu de laisser croire à une
        -- file qui avance.
        WHEN po.status IN ('conflict', 'failed')
             AND (o.status IS NULL OR o.status NOT IN ('conflict', 'failed'))
            THEN 'blocked'
        WHEN o.status IS NOT NULL THEN o.status
        WHEN p.server_updated_at IS NULL THEN 'draft'
        ELSE 'synced'
    END AS sync_status
FROM prospects AS p
LEFT JOIN outbox AS o
    ON o.entity_type = 'prospect'
    AND o.entity_id = p.id
    AND o.status IN ('pending', 'syncing', 'conflict', 'failed')
    AND o.seq = (
        SELECT MIN(o2.seq) FROM outbox AS o2
        WHERE o2.entity_type = 'prospect'
          AND o2.entity_id = p.id
          AND o2.status IN ('pending', 'syncing', 'conflict', 'failed')
    )
LEFT JOIN outbox AS po
    ON po.entity_type = 'representant'
    AND po.entity_id = p.representant_id
    AND po.status IN ('pending', 'syncing', 'conflict', 'failed')
    AND po.seq = (
        SELECT MIN(po2.seq) FROM outbox AS po2
        WHERE po2.entity_type = 'representant'
          AND po2.entity_id = p.representant_id
          AND po2.status IN ('pending', 'syncing', 'conflict', 'failed')
    );

-- ─────────────────────────────────────────────────────────────────────────────
-- Requêtes nommées
-- ─────────────────────────────────────────────────────────────────────────────

countRepresentants:
    SELECT COUNT(*) AS c FROM representants WHERE deleted_at IS NULL;

countProspects:
    SELECT COUNT(*) AS c FROM prospects WHERE deleted_at IS NULL;

countPendingOutbox:
    SELECT COUNT(*) AS c FROM outbox
    WHERE status IN ('pending', 'syncing', 'conflict', 'failed');

-- Ce qu'une exécution de fond pourrait encore faire avancer.
--
-- Distinct de `countPendingOutbox`, et l'écart est le correctif : ce dernier
-- compte aussi `conflict` et `failed`, qui n'avanceront JAMAIS sans une action
-- humaine. Le coordinateur s'en servait pour décider d'enfiler un one-off
-- WorkManager à chaque passage en arrière-plan : une seule opération
-- définitivement en échec suffisait donc à programmer un worker à chaque mise en
-- veille, indéfiniment, pour un travail qu'aucun worker ne peut faire. C'est
-- exactement le quota JobScheduler qu'Android 16 compte et que le commentaire de
-- `enqueueCatchUp` prétendait épargner.
countSchedulableOutbox:
    SELECT COUNT(*) AS c FROM outbox
    WHERE status IN ('pending', 'syncing');

-- Ce qu'aucun envoi ne fera plus avancer : il faut une décision humaine.
-- Compté à part pour que « sera envoyé au retour du réseau » ne porte plus sur
-- des lignes qui ne partiront jamais.
countBlockedOutbox:
    SELECT COUNT(*) AS c FROM outbox
    WHERE status IN ('conflict', 'failed');

countOutboxByStatus:
    SELECT status, COUNT(*) AS c FROM outbox GROUP BY status;

-- Opérations candidates au prochain lot : ouvertes ET hors chaîne empoisonnée.
--
-- Le `NOT EXISTS` EST le correctif. Le sélecteur lisait auparavant « les
-- 2000 premières lignes ouvertes par `seq` », puis écartait en Dart les chaînes
-- dont la tête était `conflict` ou `failed`. Un échec de lot terminal marque
-- 200 lignes d'un coup : dix lots refusés suffisaient donc à ce que les
-- 2000 lignes lues soient TOUTES empoisonnées, et le travail réellement en
-- attente, plus loin dans la file, devenait invisible. Le compteur se figeait,
-- sans erreur, sans explication, et aucune action de l'utilisateur ne pouvait le
-- débloquer puisque l'écran « À corriger » ne montrait que les 200 premières.
--
-- Exclure en SQL plutôt que tronquer : la limite ne borne plus que du travail
-- réellement éligible.
--
-- `COALESCE(dependency_key, 'op:' || id)` reproduit la règle du sélecteur : une
-- opération sans clé est sa propre partition, elle ne dépend de rien et rien ne
-- dépend d'elle.
claimableOutbox:
    SELECT o.* FROM outbox AS o
    WHERE o.status IN ('pending', 'syncing')
      AND NOT EXISTS (
          SELECT 1 FROM outbox AS p
          WHERE p.status IN ('conflict', 'failed')
            AND p.seq < o.seq
            AND COALESCE(p.dependency_key, 'op:' || p.id)
                = COALESCE(o.dependency_key, 'op:' || o.id)
      )
    ORDER BY o.seq ASC
    LIMIT :maxRows;

representantsWithStatus:
    SELECT * FROM representant_sync_view
    WHERE deleted_at IS NULL
    ORDER BY client_created_at DESC;

-- Bornees, et l'ecran DIT quand il coupe. Sans limite, une fiche a deux cents
-- prospects construit deux cents sous-arbres a chaque reconstruction, sur des
-- telephones modestes.
prospectsForRepresentant:
    SELECT * FROM prospect_sync_view
    WHERE representant_id = :representantId AND deleted_at IS NULL
    ORDER BY client_created_at DESC
    LIMIT :maxRows;

commentsForRepresentant:
    SELECT * FROM representant_comments
    WHERE representant_id = :representantId
    ORDER BY client_created_at DESC
    LIMIT :maxRows;

-- ── Phase 2 ──────────────────────────────────────────────────────────────────

-- Recherche exacte. `= :phone` et jamais `LIKE` : le paramètre est déjà
-- normalisé en E.164 par le client avec les mêmes règles que le serveur, donc
-- l'égalité stricte est à la fois correcte et la seule forme que
-- `phase2_directory_phone_unique` sait servir en O(log n).
phase2ByPhone:
    SELECT * FROM phase2_directory WHERE phone_e164 = :phone;

countPhase2Directory:
    SELECT COUNT(*) AS c FROM phase2_directory;

-- Écritures de phase 2 encore en file. Distinct de `countPendingOutbox` : sur
-- l'écran de phase 2, la question est « mes appels sont-ils partis ? », et y
-- mêler la file de phase 1 afficherait un chiffre que rien sur cet écran ne
-- permet de faire baisser.
countPhase2Pending:
    SELECT COUNT(*) AS c FROM outbox
    WHERE entity_type = 'call_attempt'
      AND status IN ('pending', 'syncing', 'conflict', 'failed');

-- Progression PERSONNELLE : ce que ce commercial a saisi sur CET appareil.
-- Ce n'est pas l'avancement de la campagne, et l'écran ne le présente pas comme
-- tel : le programme officiel est le PDF papier.
countMyAttempts:
    SELECT COUNT(*) AS c FROM call_attempts;

-- Sur l'EFFET et non sur l'issue : un motif ajouté par le client qui ferme sur
-- une méthode obtenue compte ici, sans que ce fichier ait à connaître son code.
countMyMethods:
    SELECT COUNT(*) AS c FROM call_attempts WHERE effect = 'CLOSE_METHOD';

-- Dossiers que mes appels ont clos.
--
-- Les issues terminales ne sont PAS listées ici : c'était la quatrième copie
-- d'une règle que le serveur est seul à trancher. Elle vit désormais dans
-- `CallEffects.closing`, et le compte se fait côté Dart
-- (`Phase2DirectorySync.countClosed`).

attemptsForProspect:
    SELECT * FROM call_attempts
    WHERE prospect_id = :prospectId
    ORDER BY client_created_at DESC;


-- ── Notifications ────────────────────────────────────────────────────────────

countUnreadNotifications:
    SELECT COUNT(*) AS c FROM notifications WHERE read_at IS NULL;

-- Rappels promis pendant un appel représentant (issue CALLBACK), pour armer la
-- notification locale et le popup in-app. `full_name`/`phone_e164` sont
-- DUPLIQUÉS depuis `representants` : la fiche peut être modifiée ou purgée
-- entre-temps, et le rappel doit rester lisible hors-ligne même alors.
CREATE TABLE rep_callback_reminders (
    id TEXT NOT NULL PRIMARY KEY,
    representant_id TEXT NOT NULL,
    full_name TEXT NOT NULL,
    phone_e164 TEXT NOT NULL,
    scheduled_at DATETIME NOT NULL,
    -- NULL tant que le popup in-app ne l'a pas montré. Voir `notifications.read_at`
    -- pour le même patron.
    notified_at DATETIME NULL,
    created_at DATETIME NOT NULL
);

CREATE INDEX rep_callback_reminders_pending_idx ON rep_callback_reminders (notified_at, scheduled_at);

pendingRepCallbackReminders:
    SELECT * FROM rep_callback_reminders
    WHERE notified_at IS NULL
    ORDER BY scheduled_at ASC;

-- ── Registre des visites ─────────────────────────────────────────────────────
--
-- Le serveur est seul à l'écrire, un pull rejoué recopie la même ligne, `updated_at` seul
-- arbitre. Les entreprise/objet/direction/destinataire voyagent DÉNORMALISÉS
-- (id + libellé), même patron que `departements.region_name` : cette table
-- n'a pas de miroir local des référentiels de visite, le tirage étant la seule
-- source. `reference` est NULL tant que l'inscription reste en file : le
-- serveur seul l'attribue, et le tirage qui suit la poussée la complète.
--
-- AUCUNE clé étrangère, AUCUN CHECK d'énumération : le serveur reste la source
-- de vérité pour les références du registre.
CREATE TABLE visites (
    id TEXT NOT NULL PRIMARY KEY,
    reference TEXT NULL,
    date TEXT NOT NULL,
    time TEXT NULL,
    visitor_name TEXT NOT NULL,
    phone TEXT NULL,
    phone_e164 TEXT NULL,
    entreprise_id TEXT NOT NULL,
    entreprise_label TEXT NOT NULL,
    objet_id TEXT NOT NULL,
    objet_label TEXT NOT NULL,
    direction_id TEXT NULL,
    direction_label TEXT NULL,
    destinataire_id TEXT NULL,
    destinataire_label TEXT NULL,
    comment TEXT NULL,
    created_by_id TEXT NOT NULL,
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL
);

CREATE INDEX visites_date_idx ON visites (date, time);

-- Sert le filtre par entreprise sur la période « Tout » de l'historique.
-- Rien n'aide la RECHERCHE : `LIKE '%awa%'` porte un joker en tête, que SQLite
-- ne peut indexer. Ne pas ajouter d'index dessus en croyant corriger un oubli.
CREATE INDEX visites_entreprise_date_idx ON visites (entreprise_id, date);

-- ── Preuves d'appel ──────────────────────────────────────────────────────────
--
-- Un appel LANCÉ depuis une fiche, et ce que le journal du téléphone en dit une
-- fois raccroché. `mode = 'detecte'` est l'autre origine : un appel RETROUVÉ
-- dans le journal du téléphone, passé ou reçu hors de l'application. Dans les
-- deux cas la ligne part d'une entité du CRM : un numéro sans fiche n'est ni
-- stocké ni compté.
--
-- `attempt_id` marque la preuve déjà attachée à une tentative envoyée : sans
-- lui, deux appels consignés d'affilée porteraient la même preuve.
--
-- `signale_at` : la feuille « Appels à consigner » l'a montré, elle ne le
-- remontrera pas d'elle-même. `ignore_at` : l'utilisateur a dit que cet appel
-- n'est pas à consigner.
CREATE TABLE preuves_appel (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL CHECK (kind IN ('representant', 'prospect')),
    entity_id TEXT NOT NULL,
    phone_e164 TEXT NOT NULL,
    lance_at DATETIME NOT NULL,
    mode TEXT NOT NULL,
    journal_type TEXT NULL,
    journal_duree_s INTEGER NULL,
    journal_at DATETIME NULL,
    rapproche_at DATETIME NULL,
    attempt_id TEXT NULL,
    signale_at DATETIME NULL,
    ignore_at DATETIME NULL
);

CREATE INDEX preuves_appel_entite_idx ON preuves_appel (kind, entity_id, lance_at);

dernierePreuvePour:
    SELECT * FROM preuves_appel
    WHERE kind = :kind AND entity_id = :entityId
    ORDER BY lance_at DESC
    LIMIT 1;

-- `unixepoch()` et non `>=` sur le texte : les horodatages sont stockés en
-- ISO-8601 avec leur décalage (voir `build.yaml`), et deux décalages différents
-- se compareraient dans le désordre. Le seuil voyage donc en secondes UNIX.
preuvesEnAttente:
    SELECT * FROM preuves_appel
    WHERE unixepoch(lance_at) >= :seuilSecondes AND journal_at IS NULL
    ORDER BY lance_at DESC;

-- Une preuve détectée porte `lance_at = journal_at` : elle entre donc dans cette
-- fenêtre par la même colonne qu'un appel lancé depuis la fiche, et la tentative
-- consignée repart avec ce que le téléphone a inscrit.
preuveAConsommer:
    SELECT * FROM preuves_appel
    WHERE kind = :kind AND entity_id = :entityId
      AND rapproche_at IS NOT NULL AND attempt_id IS NULL
      AND unixepoch(lance_at) >= :seuilSecondes
    ORDER BY lance_at DESC
    LIMIT 1;

-- Les appels retrouvés dans le journal et pas encore consignés, avec de quoi
-- nommer la fiche sans une requête par ligne. `ignore_at` sort la ligne pour de
-- bon ; `signale_at` ne fait que dire que la feuille l'a déjà montrée.
appelsAConsigner:
    SELECT p.*,
           r.full_name AS rep_nom,
           r.relation_status AS rep_relation,
           r.last_call_outcome AS rep_issue,
           sq.label AS rep_statut_label,
           sq.effect AS rep_statut_effect,
           pr.prenom AS pros_prenom,
           pr.nom AS pros_nom,
           pr.projet AS pros_projet
    FROM preuves_appel AS p
    LEFT JOIN representants AS r
        ON p.kind = 'representant' AND r.id = p.entity_id
    LEFT JOIN statuts_qualification AS sq ON sq.id = r.statut_qualification_id
    LEFT JOIN prospects AS pr
        ON p.kind = 'prospect' AND pr.id = p.entity_id
    WHERE p.mode = 'detecte' AND p.attempt_id IS NULL AND p.ignore_at IS NULL
    ORDER BY p.journal_at DESC;

-- Le même appel vu deux fois par deux balayages : les horloges du journal et de
-- l'application ne sont pas la même, une minute d'écart reste le même appel.
preuveExiste:
    SELECT COUNT(*) FROM preuves_appel
    WHERE kind = :kind AND entity_id = :entityId AND journal_at IS NOT NULL
      AND abs(unixepoch(journal_at) - :journalAtSecondes) <= 60;

-- La fiche qui porte ce numéro, représentant d'abord. `last_call_at` voyage
-- avec elle : c'est ce qui dit qu'un appel du journal a DÉJÀ été consigné.
ficheParTelephone:
    SELECT 'representant' AS kind, id AS entity_id, full_name AS libelle,
           last_call_at AS dernier_appel
    FROM representants WHERE phone_e164 = :e164 AND deleted_at IS NULL
    UNION ALL
    SELECT 'prospect', id, prenom || ' ' || nom, last_call_at
    FROM prospects WHERE phone_e164 = :e164 AND deleted_at IS NULL;

-- Le prospect garde ses tentatives en local : `last_call_at` ne dit que la
-- dernière, et une saisie plus ancienne peut couvrir l'appel du journal.
appelSaisiEntre:
    SELECT COUNT(*) FROM call_attempts
    WHERE prospect_id = :prospectId
      AND unixepoch(client_created_at) BETWEEN :debutSecondes AND :finSecondes;
