<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG UNIQUEMENT. Ce fichier vit dans `src/debug/`, donc il n'entre jamais
  dans un APK de release, où la configuration par défaut d'Android s'applique :
  refus du trafic en clair.

  Depuis Android 9 (API 28) le trafic en clair est refusé par défaut, et la
  cible est `targetSdk = 36`. Le serveur de développement écoute en HTTP.
  Sans exception, toutes les requêtes échouent en `CLEARTEXT_NOT_PERMITTED`,
  qui remonte comme une simple erreur de connexion et se confond avec « pas de
  réseau ».

  L'exception était nominative : `10.0.2.2` pour l'émulateur, `localhost` pour
  `adb reverse`. Les deux passent par le câble. Un appareil physique branché sur
  le Wi-Fi vise l'adresse privée de la machine de build, attribuée par DHCP et
  différente d'un poste et d'un jour à l'autre. La configuration de sécurité
  réseau ne sait pas décrire une plage d'adresses : seules des entrées d'hôte
  littérales existent. Nommer une adresse ici reviendrait à figer dans le dépôt
  la différence d'environnement d'une seule machine, et à casser en silence à
  la prochaine attribution de bail.

  Vérifier hors ligne sur un vrai téléphone EXIGE le Wi-Fi : `adb reverse`
  continue de router par le câble USB quand le mode avion est actif, et le test
  hors ligne passerait pour une raison fausse.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
