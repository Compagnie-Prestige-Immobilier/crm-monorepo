<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!--
      CPI GO est auto-distribuée : c'est elle qui pose ses propres mises à jour,
      par une session `PackageInstaller` (voir UpdatesChannel). Sans cette
      permission, `setRequireUserAction(USER_ACTION_NOT_REQUIRED)` est ignoré et
      CHAQUE mise à jour repasse par l'écran système, y compris quand CPI GO est
      déjà propriétaire de la mise à jour du paquet.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>

    <!--
      POST_NOTIFICATIONS avait été retirée avec Firebase (les annonces
      restent servies par l'inbox applicative, voir
      `features/notifications/notification_inbox.dart`), mais revient ici
      pour UN SEUL usage : l'alarme locale d'un rappel promis à un
      représentant (issue CALLBACK). Toujours sans Firebase : c'est
      `flutter_local_notifications`, planifié sur l'appareil, sans serveur
      push.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!--
      Le rappel promis est une alarme, pas une annonce : il doit tomber à
      l'heure convenue, écran éteint et application fermée.

      RECEIVE_BOOT_COMPLETED : sans elle, un redémarrage perd toutes les
      alarmes posées. Le récepteur du greffon (plus bas) les repose.

      USE_EXACT_ALARM plutôt que SCHEDULE_EXACT_ALARM seule : depuis Android
      14 la seconde se demande à l'utilisateur et se révoque, la première est
      accordée d'office aux applications de type réveil. CPI GO est
      auto-distribuée (voir REQUEST_INSTALL_PACKAGES et le module de mise à
      jour) : l'audit du Play Store sur USE_EXACT_ALARM ne s'y applique pas.
      SCHEDULE_EXACT_ALARM reste déclarée pour les appareils sous Android 13,
      où USE_EXACT_ALARM n'existe pas.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!--
      Preuve d'appel. CALL_PHONE compose sans passer par le composeur, sinon
      l'application retombe sur ACTION_DIAL. READ_CALL_LOG rapproche la
      tentative saisie avec l'appel réellement passé, READ_PHONE_STATE suit
      l'état de la ligne. Aucune n'est demandée au démarrage : le diagnostic
      les demande une par une.

      FOREGROUND_SERVICE_PHONE_CALL est déclarée mais Android 14 ne l'accorde
      qu'aux applications qui gèrent leurs propres appels ; le service retombe
      alors sur dataSync.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!--
      CONFIDENTIALITÉ AU REPOS : voir android:allowBackup ci-dessous.

      La base locale vit dans le stockage privé de l'application
      (`getApplicationSupportDirectory`), donc hors de portée des autres
      applications. Elle contient l'annuaire de phase 2 : jusqu'à 500 000
      numéros de téléphone répliqués sur le téléphone PERSONNEL du commercial :
      et l'outbox des saisies non encore transmises.

      `allowBackup="false"` ferme la seule sortie qui restait : sans lui,
      Android Auto Backup recopie tout le répertoire privé vers le Google Drive
      du porteur de l'appareil, et l'annuaire s'y retrouve intact, hors de tout
      contrôle de CPI. Les deux fichiers de règles référencés sont le filet de
      sécurité si ce drapeau était un jour rouvert.

      Contrepartie assumée : un changement de téléphone repart d'une base vide,
      et l'annuaire se retélécharge. C'est exactement le comportement voulu : la
      nouvelle installation passe par une authentification.
    -->
    <application
        android:label="CPI GO"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Les deux récepteurs de `flutter_local_notifications` : le premier
          affiche l'alarme à l'heure dite, le second repose les alarmes après
          un redémarrage ou une mise à jour de l'application.

          PAS de android:showWhenLocked ni de android:turnScreenOn sur
          MainActivity : ils laisseraient l'application s'ouvrir PAR-DESSUS
          l'écran verrouillé, annuaire de phase 2 compris (voir
          android:allowBackup plus haut). L'alarme reste plein écran sur le
          verrouillage ; ouvrir la fiche demande de déverrouiller.
        -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".SynchroService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <service
            android:name=".AppelService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|dataSync"/>
        <!--
          Le rôle de filtrage n'appartient qu'à une application à la fois sur
          l'appareil ; il se demande depuis le diagnostic, jamais au démarrage.
        -->
        <service
            android:name=".CpiCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService"/>
            </intent-filter>
        </service>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
