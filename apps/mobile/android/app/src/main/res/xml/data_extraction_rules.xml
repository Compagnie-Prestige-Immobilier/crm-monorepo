<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31). Deux blocs distincts, et c'est délibéré :
  `cloud-backup` gouverne la sauvegarde Google Drive, `device-transfer` le
  transfert d'appareil à appareil. Ne renseigner que l'un des deux laisse
  l'autre au comportement par défaut, qui est « tout emporter ».

  Ici les deux sont vides de toute inclusion, donc rien ne sort. La base
  `cpi_go.sqlite` contient l'annuaire de phase 2 — jusqu'à 500 000 numéros de
  téléphone répliqués sur un appareil personnel — et l'outbox, c'est-à-dire des
  saisies terrain non encore transmises. Aucun des deux n'a de raison d'exister
  ailleurs que sur cet appareil et sur le serveur.

  Les exclusions explicites sont redondantes avec l'absence d'inclusion. Elles
  sont écrites quand même : le jour où quelqu'un ajoutera une inclusion ici pour
  une préférence anodine, la base restera exclue au lieu de partir avec.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <!-- Chemin d'ouverture de drift_flutter (`getApplicationSupportDirectory`). -->
        <exclude domain="file" path="cpi_go.sqlite" />
        <exclude domain="file" path="cpi_go.sqlite-wal" />
        <exclude domain="file" path="cpi_go.sqlite-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" path="cpi_go.sqlite" />
        <exclude domain="file" path="cpi_go.sqlite-wal" />
        <exclude domain="file" path="cpi_go.sqlite-shm" />
    </device-transfer>
</data-extraction-rules>
