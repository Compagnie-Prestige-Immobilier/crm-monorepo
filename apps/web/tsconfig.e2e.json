{
  // Les specs Playwright ne peuvent PAS entrer dans `tsconfig.json` : Next y
  // ajoute ses propres types de routes et compile ce projet pour le navigateur,
  // alors que `e2e/` tourne sous Node et importe `@playwright/test`.
  //
  // Elles étaient donc vérifiées par RIEN : ni `tsc -p tsconfig.json` (qui
  // n'inclut que `src/**`), ni `eslint src`. C'est exactement ainsi qu'une
  // assertion portant sur un lien de navigation nommé « Commerciaux », qui n'a
  // jamais existé sous ce nom, a pu rester verte en permanence : elle vérifiait
  // l'absence d'une chose absente par construction.
  //
  // Ce projet ne sert qu'à la vérification (`--noEmit`) : rien n'en sort.
  "extends": "@crm/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["e2e/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
