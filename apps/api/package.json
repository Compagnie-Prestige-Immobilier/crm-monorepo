{
  "name": "@crm/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.gen.json && (tsc -p tsconfig.gen.json --watch --preserveWatchOutput & node --watch --watch-preserve-output --enable-source-maps dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "oxlint --config .oxlintrc.json --report-unused-disable-directives src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "VITEST_INCLUDE_INTEGRATION=1 vitest run --config vitest.integration.config.ts --passWithNoTests",
    "openapi:generate": "tsc -p tsconfig.gen.json && node dist/openapi.js && prettier openapi.json --write"
  },
  "dependencies": {
    "@crm/api-client-chues": "workspace:*",
    "@crm/api-client-grand-public": "workspace:*",
    "@crm/database": "workspace:*",
    "@devicefarmer/adbkit-apkreader": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/websocket": "11.3.0",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "argon2": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "exceljs": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "jszip": "catalog:",
    "libphonenumber-js": "catalog:",
    "nestjs-pino": "catalog:",
    "pdfkit": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "pino-roll": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crm/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pdfkit": "catalog:",
    "@types/ws": "8.18.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
