// Compilation utilisée par `pnpm openapi:generate` et par `pnpm dev`.
//
// Identique à tsconfig.build.json, MAIS elle inclut `src/openapi.ts`, que la
// compilation de production exclut.
//
// Pourquoi passer par tsc plutôt que d'exécuter le TypeScript directement :
// `emitDecoratorMetadata` n'est émis QUE par tsc. Les exécuteurs fondés sur
// esbuild (tsx) suppriment les types sans produire `design:type` ni
// `design:paramtypes` — or @nestjs/swagger n'a que cette métadonnée pour
// connaître le type d'un `@Body()` ou d'une propriété de DTO. Générer le
// contrat sans elle produit un document syntaxiquement valide et vide de tout
// schéma : le client Dart engendré n'a plus que des `Object`. La même
// métadonnée conditionne la validation par class-validator à l'exécution.
{
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts", "src/**/fake-*.ts", "dist", "node_modules"]
}
