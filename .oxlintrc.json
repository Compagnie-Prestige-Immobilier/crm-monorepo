{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off"
  },
  "plugins": ["typescript", "import", "react", "jsx-a11y", "unicorn", "oxc"],
  "jsPlugins": ["eslint-plugin-sonarjs"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "rules": {
    "complexity": ["error", { "max": 10, "variant": "classic" }],
    "max-depth": ["error", 2],
    "no-nested-ternary": "error",
    "sonarjs/cognitive-complexity": ["error", 10],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "import/no-cycle": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/aria-role": ["error", { "ignoreNonDOM": true }],
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["tabpanel", "region"] }],
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "depth": 3, "controlComponents": ["Select"] }
    ],
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "depth": 5,
        "ignoreElements": ["audio", "canvas", "embed", "input", "option", "textarea", "tr", "video"]
      }
    ]
  }
}
