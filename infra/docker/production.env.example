# Copier en infra/docker/.env sur le VPS, puis remplir. Ne JAMAIS committer.
#
#   cp production.env.example .env && chmod 600 .env
#
# Compose charge automatiquement le .env du répertoire du fichier compose,
# c'est-à-dire celui-ci. Les valeurs marquées `:?` dans docker-compose.prod.yml
# font échouer le `up` si elles manquent, plutôt que de démarrer une pile à
# moitié configurée.
#
# (Ce fichier ne s'appelle pas .env.prod.example à dessein : le .gitignore de
# la racine ignore `.env.*` et l'exception ne couvre que `.env.example`.)

# --- Domaine et TLS ---------------------------------------------------------
# Enregistrement A pointant sur le VPS. Caddy obtient le certificat pour ce nom.
DOMAIN=go.cpi.sn
# Adresse à laquelle Let's Encrypt écrit avant expiration. Doit être relevée.
ACME_EMAIL=tech@cpi.sn

# --- Base de données --------------------------------------------------------
POSTGRES_DB=crm
POSTGRES_USER=crm
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Cache ----------------------------------------------------------------
# openssl rand -base64 32
REDIS_PASSWORD=

# --- Application ------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# Au moins 32 caractères chacun, et DIFFÉRENTS l'un de l'autre : un secret
# commun permettrait de présenter un jeton de rafraîchissement comme un jeton
# d'accès. Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT=10

# --- Règles métier ----------------------------------------------------------
BUSINESS_TIME_ZONE=Africa/Dakar
# Clé de déduplication : doit être identique à la valeur compilée dans l'app
# mobile, sinon deux normalisations différentes du même numéro coexistent.
PHONE_DEFAULT_REGION=SN
SYNC_MAX_BATCH_SIZE=200
IDEMPOTENCY_TTL_DAYS=7

# --- Notifications ----------------------------------------------------------
# E-mail (Brevo) : clé de l'API transactionnelle et expéditeur. C'est le SEUL
# canal sortant ; la boîte de réception de l'application sert tout le monde et
# ne dépend d'aucune configuration.
#
# VIDE EST VALIDE, et c'est l'état par défaut. L'e-mail est adressé aux
# téléconseillers (rôle COMMERCIAL) disposant d'une adresse ; son absence ne
# change ni les lignes de livraison, ni la boîte de réception. Remplir ces trois
# valeurs depuis un secret Dokploy, jamais en clair dans un dépôt.
#
# Le domaine de BREVO_SENDER_EMAIL doit être vérifié dans le compte Brevo,
# sinon les messages partent en spam ou ne partent pas du tout.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Rappels programmés. Heure au format HH:MM dans BUSINESS_TIME_ZONE.
NOTIFICATIONS_REMINDERS_ENABLED=true
NOTIFICATIONS_REMINDERS_AT=08:00

# Rappels du pôle BANQUE_FINANCE, sur l'écran /dossiers. Le compte est global :
# un dossier bancaire n'a pas de propriétaire, c'est le pôle entier qui le fait
# avancer, et tous ses membres reçoivent le même chiffre.
#
# « En attente » : dossiers encore à une étape OPEN plus de N jours après leur
# dépôt. Sous ce seuil, le rappel tomberait pendant le délai de traitement
# normal de la banque et deviendrait un bruit de fond qu'on apprend à ignorer.
NOTIFICATIONS_BANK_PENDING_ENABLED=true
NOTIFICATIONS_BANK_PENDING_DAYS=5
# « Sans mouvement » : dossiers ouverts qu'aucune transition n'a touchés depuis
# N jours. Seuil plus haut, parce que le signal est différent : là une lenteur,
# ici un dossier que plus personne ne touche.
NOTIFICATIONS_BANK_STALE_ENABLED=true
NOTIFICATIONS_BANK_STALE_DAYS=10

# --- Mode démonstration -----------------------------------------------------
# NE PAS ACTIVER SUR UNE INSTANCE QUI PORTE DE VRAIES DONNÉES.
#
# À `false`, l'API refuse d'activer le mode démonstration en production, même
# pour un administrateur : c'est délibérément une variable d'environnement et
# non un réglage en base, pour rester hors de portée de l'interface.
#
# Des prospects fictifs mêlés à de vraies fiches dans un export transmis au
# siège serait un incident sérieux, et la fiabilité de la base entière
# deviendrait suspecte. Ne passer à `true` que sur une instance de
# démonstration dédiée.

# --- Sauvegardes ------------------------------------------------------------
# Chemin HÔTE, hors du volume Docker. Un disque ou un point de montage distinct
# est préférable. Doit être accessible en écriture par l'uid du conteneur.
BACKUP_DIR=/srv/cpi-go/backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
TZ=Africa/Dakar
