# syntax=docker/dockerfile:1.7
#
# Image de l'API NestJS — et, via la cible `migrator`, du service de migration.
# Contexte de build : la RACINE du dépôt (voir docker-compose.prod.yml).
#
# Le monorepo est découpé avec `turbo prune --docker`, qui produit :
#   out/json/  les package.json + le lockfile élagués → couche d'installation
#              qui n'est invalidée que quand une dépendance change
#   out/full/  les sources des seuls paquets nécessaires
# Sans cela, toucher une ligne de apps/web réinstallerait les dépendances de
# l'API à chaque build.

ARG NODE_VERSION=24.18.0
ARG PNPM_VERSION=11.15.1
ARG TURBO_VERSION=2.10.5
ARG PRISMA_VERSION=7.9.0

# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    DO_NOT_TRACK=1
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /repo

# -----------------------------------------------------------------------------
# Découpage du workspace.
# -----------------------------------------------------------------------------
FROM base AS pruner
ARG TURBO_VERSION
RUN npm install -g turbo@${TURBO_VERSION}
COPY . .
RUN turbo prune @crm/api --docker

# -----------------------------------------------------------------------------
# Dépendances complètes + compilation TypeScript.
# -----------------------------------------------------------------------------
FROM base AS builder
# argon2 est natif. Il publie des binaires précompilés, mais si le triplet de
# la plateforme n'en a pas, node-gyp doit pouvoir compiler — sinon l'échec
# arrive à l'installation avec un message très indirect.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ ./
RUN pnpm --filter @crm/database db:generate
# pnpm et non turbo : la tâche turbo `build` dépend de `generate`, qui dépend
# de `@crm/api#openapi:generate`. Régénérer le contrat exigerait ici le
# workspace entier. Le code généré étant committé (ADR 0002), l'image se
# contente de compiler ce qui est dans l'arbre — et la CI garantit par
# ailleurs que cet arbre est à jour.
RUN pnpm --filter @crm/database build \
    && pnpm --filter @crm/api build

# -----------------------------------------------------------------------------
# Dépendances de production seulement.
# -----------------------------------------------------------------------------
FROM base AS prod-deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod
# Le client Prisma vit dans node_modules et vient d'être effacé par
# l'installation --prod (le CLI `prisma` est une devDependency). On le
# régénère avec un CLI global épinglé sur la même version que @prisma/client :
# un décalage ici produit une erreur au premier accès à la base, en production.
ARG PRISMA_VERSION
COPY --from=pruner /repo/out/full/packages/database/prisma ./packages/database/prisma
RUN npm install -g prisma@${PRISMA_VERSION} \
    && prisma generate --schema packages/database/prisma/schema.prisma \
    && npm uninstall -g prisma

# -----------------------------------------------------------------------------
# Migrations. Repose sur `builder`, pas sur `prod-deps` : `prisma migrate
# deploy` a besoin du CLI Prisma ET de packages/database/prisma.config.ts, qui
# importe `prisma/config` — deux devDependencies absentes d'une image de
# production. Ce conteneur vit trente secondes ; sa taille est sans intérêt,
# sa correction non.
# -----------------------------------------------------------------------------
FROM builder AS migrator
WORKDIR /repo/packages/database
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# -----------------------------------------------------------------------------
# Image finale.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS runner
ENV NODE_ENV=production \
    PORT=3001
WORKDIR /repo

# Utilisateur non root. L'image node fournit déjà `node` (uid 1000) : on ne
# crée rien, on cesse simplement d'être root.
COPY --from=prod-deps --chown=node:node /repo ./
COPY --from=builder   --chown=node:node /repo/packages/database/dist ./packages/database/dist
COPY --from=builder   --chown=node:node /repo/apps/api/dist ./apps/api/dist
# Le schéma et les migrations : le point d'entrée applique `migrate deploy`
# avant de démarrer, pour que l'image soit autonome là où il n'existe pas de
# service de migration séparé (Dokploy, Railway…).
COPY --from=builder   --chown=node:node /repo/packages/database/prisma ./packages/database/prisma
# prisma.config.ts porte la chaîne de connexion : Prisma 7 l'interdit dans le
# schéma et la lit UNIQUEMENT ici. Sans ce fichier, `migrate deploy` ne sait pas
# où se connecter et le conteneur redémarre en boucle.
COPY --from=builder   --chown=node:node /repo/packages/database/prisma.config.ts ./packages/database/prisma.config.ts
COPY --chown=node:node infra/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh
# The APK volume is mounted over this directory in production. Creating it with
# the runtime user's ownership lets Docker initialize a new named volume with
# permissions that the non-root API can write to.
RUN mkdir -p /repo/storage/releases && chown -R node:node /repo/storage

USER node
EXPOSE 3001

# Le point d'entrée migre puis `exec` Node : le shell est remplacé, donc Node
# reste PID 1 et reçoit SIGTERM directement.
CMD ["/usr/local/bin/api-entrypoint.sh"]
