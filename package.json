{
  "name": "cpi-crm",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dead-code": "knip --include files,dependencies,unlisted",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "plafonds": "tools/dev/plafonds.sh",
    "contrat:ecarts": "node tools/dev/contrat-ecarts.cjs",
    "lint:go": "go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...",
    "complexite:go": "go run github.com/uudashr/gocognit/cmd/gocognit@latest -top 10 ./cmd ./internal && go run github.com/fzipp/gocyclo/cmd/gocyclo@latest -top 10 cmd internal",
    "verify:local": "pnpm format:check && pnpm lint && pnpm dead-code && pnpm typecheck && pnpm plafonds && pnpm lint:go",
    "prepare": "test ! -d .git || lefthook install"
  },
  "devDependencies": {
    "eslint-plugin-sonarjs": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
