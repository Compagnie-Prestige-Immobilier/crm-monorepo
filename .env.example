# Copie en .env à la racine. Chaque clé est lue par le binaire Go (internal/shared/socle/config.go
# et les domaines) ; rien d'autre ne lit ce fichier. Les valeurs sont celles du poste de travail.

# --- Serveur ---
PORT=4000
LOG_LEVEL=info
LOG_FORMAT=text
# `development` autorise le mot de passe admin par défaut du seed ; `production` refuse les comptes fixtures.
NODE_ENV=development
# Derrière Traefik et Cloudflare seulement : l'adresse cliente et le protocole viennent des en-têtes X-Forwarded-*.
API_TRUST_PROXY_HEADERS=false
# TACHES_PLANIFIEES=false : aucune tâche planifiée, pour un hôte d'essai à côté de la v1.

# --- Données ---
DATABASE_URL=postgres://localhost:5432/cpi_v2_dev?sslmode=disable
# TEST_DATABASE_URL=postgres://localhost:5432/cpi_v2_dev?sslmode=disable

# --- Session et comptes ---
SESSION_TTL_DAYS=30
# Connexions refusées par adresse et par minute avant le plafonnement.
AUTH_LOGIN_RATE_LIMIT=10
# Requêtes /api par adresse et par minute, 0 = sans plafond (3000 en production).
API_GLOBAL_RATE_LIMIT=0
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=24
SEED_ADMIN_EMAIL=admin@cpi.sn
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-local-2026
SEED_ADMIN_FULL_NAME=Administrateur CPI
SEED_FIXTURE_PASSWORD=ChangeMoi123456

# --- Règles métier ---
PHONE_DEFAULT_REGION=SN
BUSINESS_TIME_ZONE=Africa/Dakar
PUBLIC_WEB_URL=http://localhost:4000

# --- Fichiers ---
NOTE_VOCALE_DIR=./storage/notes-vocales
NOTE_VOCALE_MAX_SIZE_BYTES=25000000
NOTE_VOCALE_RETENTION_HOURS=48
IMPORTS_DIR=./storage/imports
IMPORTS_SWEEP_ENABLED=true
DB_DUMP_DIR=./storage/db-dumps
DB_DUMP_ENABLED=false

# --- Notifications (Brevo) : sans clé, les envois sont marqués NOT_CONFIGURED ---
# BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@cpi.sn
BREVO_SENDER_NAME=CRM CPI
# BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email
NOTIFICATIONS_REMINDERS_AT=08:00
NOTIFICATIONS_DAILY_REPORT_AT=17:00

# --- Plateformes d'enrôlement : une plateforme sans URL ou sans jeton est « non configurée » ---
# PLATEFORME_CHUES_URL=https://apii.cpi-chues.com/api
# PLATEFORME_CHUES_TOKEN=
# PLATEFORME_GRAND_PUBLIC_URL=https://api.cpi.sn/api
# PLATEFORME_GRAND_PUBLIC_TOKEN=

# --- Formulaire public (Cloudflare Turnstile) : sans secret, l'envoi est refusé sauf ALLOW_DEGRADED ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOW_DEGRADED=false
