# Copy to .env at the repo root. Loaded by apps/api at startup.
# Every key below is read by code; see apps/api/src/env.ts.

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
# Serves Swagger UI at /api/docs and the raw spec at /api/openapi.json.
# Keep false in production.
API_DOCS_ENABLED=true
# Only enable behind a proxy that overwrites X-Forwarded-For. When true, the
# client IP used for throttling becomes spoofable.
API_TRUST_PROXY_HEADERS=false

# --- Data ---
DATABASE_URL=postgresql://crm:crm@localhost:5434/crm?schema=public

# --- Auth ---
# Both secrets must be at least 32 characters. The placeholders below are
# deliberately too short so an unedited copy fails at boot instead of shipping
# a known signing key. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-minimum-32-characters
JWT_REFRESH_SECRET=change-me-too-minimum-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Failed logins allowed per IP per minute before the throttler kicks in.
AUTH_LOGIN_RATE_LIMIT=10
API_GLOBAL_RATE_LIMIT=300

# --- Business rules ---
BUSINESS_TIME_ZONE=Africa/Dakar
# Region used to parse locally-typed phone numbers into E.164 (+221...).
# This is the deduplication key on both Representant and Prospect, so it must
# match the value compiled into the mobile app.
PHONE_DEFAULT_REGION=SN
# Maximum operations accepted in a single POST /sync/push batch.
SYNC_MAX_BATCH_SIZE=200
# How long a replayed Idempotency-Key keeps returning its memorised response.
IDEMPOTENCY_TTL_DAYS=7

# APK Android : monter ce dossier sur un volume persistant du VPS.
APK_RELEASE_DIR=./storage/releases
APK_MAX_SIZE_BYTES=524288000

# Notes vocales des appels : monter ce dossier sur un volume persistant privé.
# Sans volume, un redéploiement supprime les fichiers déjà téléversés.
CALL_RECORDING_DIR=./storage/call-recordings
CALL_RECORDING_MAX_SIZE_BYTES=25000000
CALL_RECORDING_RETENTION_HOURS=48

# Exports intégraux de la base, demandés depuis Paramètres → Export intégral.
# Monter ce dossier sur un volume persistant, comme celui des APK : l'état du
# travail vit en base et nomme un fichier, qu'un redéploiement ne doit pas
# emporter. Le fichier contient la base ENTIÈRE : il est détruit dès son
# téléchargement, et de toute façon six heures après avoir été produit.
# L'image de l'API embarque pg_dump 18, épinglé sur la majeure du serveur.
DB_DUMP_DIR=./storage/db-dumps
# Interrupteur de la fonctionnalité, ÉTEINT PAR DÉFAUT. Tant qu'il ne vaut pas
# true, les trois routes d'export rendent 404 et la carte des paramètres ne
# s'affiche pas, quel que soit le rôle de l'appelant. Ce que cet export produit
# est un second exemplaire complet de la clientèle sur un volume : « réservé aux
# ADMIN » n'est pas la même chose qu'« inaccessible », et le défaut retenu est
# le second. À poser dans l'environnement de l'API ET dans celui du panel web.
DB_DUMP_ENABLED=false

# --- Mode démonstration ---
# L'interrupteur lui-même vit en base (table app_settings), manœuvrable depuis
# le panel admin sans redéploiement. Cette variable est un garde-fou distinct :
# en production, activer le mode démo est REFUSÉ tant qu'elle ne vaut pas true.
# Des données de démonstration se retrouvant dans un export de prospects réels
# serait un incident sérieux.
DEMO_MODE_ALLOWED=false

# --- Seed ---
# Consumed once by `pnpm db:seed` to create the first ADMIN account.
SEED_ADMIN_EMAIL=admin@cpi.sn
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_ADMIN_FULL_NAME=Administrateur CPI

# --- Web ---
# Server-side only: the web app's Route Handlers reach the API through this.
API_INTERNAL_URL=http://localhost:3001

# --- Notifications ---
# Interrupteur général des rappels programmés.
NOTIFICATIONS_REMINDERS_ENABLED=true
# Heure quotidienne des rappels, HH:MM dans BUSINESS_TIME_ZONE.
NOTIFICATIONS_REMINDERS_AT=08:00

# Compte rendu de fin de journée, adressé aux ADMIN et aux SUPERVISEUR.
NOTIFICATIONS_DAILY_REPORT_ENABLED=true
# Heure d'envoi, HH:MM dans BUSINESS_TIME_ZONE. Après la fermeture, sinon le
# compte rendu porte sur une journée encore en cours.
NOTIFICATIONS_DAILY_REPORT_AT=17:00

# Rappel « appels en attente » : tâches encore OPEN dans une campagne ACTIVE.
NOTIFICATIONS_OPEN_TASKS_ENABLED=true
NOTIFICATIONS_OPEN_TASKS_MIN=1

# Rappels du pôle BANQUE_FINANCE, sur l'écran /dossiers. Le compte est global :
# un dossier bancaire n'a pas de propriétaire, c'est le pôle entier qui le fait
# avancer, et tous ses membres reçoivent le même chiffre.
#
# « En attente » : dossiers encore à une étape OPEN plus de N jours après leur
# dépôt. Sous ce seuil, le rappel tomberait pendant le délai de traitement
# normal de la banque et deviendrait un bruit de fond qu'on apprend à ignorer.
NOTIFICATIONS_BANK_PENDING_ENABLED=true
NOTIFICATIONS_BANK_PENDING_DAYS=5
# « Sans mouvement » : dossiers ouverts qu'aucune transition n'a touchés depuis
# N jours. Seuil plus haut, parce que le signal est différent : là une lenteur,
# ici un dossier que plus personne ne touche.
NOTIFICATIONS_BANK_STALE_ENABLED=true
NOTIFICATIONS_BANK_STALE_DAYS=10

# --- Notifications e-mail (Brevo) ---
# Clé de l'API transactionnelle Brevo (Compte > SMTP & API > Clés API).
#
# LAISSER VIDE EST UN MODE DE FONCTIONNEMENT VALIDE. Sans clé, l'e-mail ne part
# pas et RIEN d'autre ne change : la boîte de réception de l'application sert
# tout le monde et ne dépend d'aucune configuration. L'e-mail est adressé aux
# téléconseillers (rôle COMMERCIAL) qui disposent d'une adresse, parce qu'ils
# travaillent devant un poste et pas devant un téléphone.
#
# La valeur réelle vit dans le .env local et dans un secret Dokploy sur le VPS,
# jamais ici.
BREVO_API_KEY=
# Adresse d'expédition. Son domaine doit être vérifié dans le compte Brevo,
# sinon les messages partent en spam ou ne partent pas du tout.
BREVO_SENDER_EMAIL=
# Nom affiché de l'expéditeur. Retombe sur « CPI GO » quand il est vide.
BREVO_SENDER_NAME=
