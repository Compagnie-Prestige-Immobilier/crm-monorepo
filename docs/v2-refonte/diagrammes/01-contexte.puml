@startuml 01-contexte
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
title Niveau 1 : contexte. Qui utilise CPI GO v2 et avec quoi il parle.

Person(tc, "Téléconseiller", "Terrain, téléphone Android, souvent hors ligne")
Person(enc, "Encadrement", "Superviseur, direction, admin, banque, accueil : navigateur")
Person(pub, "Prospect", "Formulaire public de demande")

System(cpi, "CPI GO v2", "Panneau, API, synchronisation mobile")

System_Ext(plat, "Plateformes d'enrôlement", "CHUES, Grand Public")
System_Ext(brevo, "Brevo", "E-mail transactionnel")
System_Ext(turn, "Cloudflare Turnstile", "Anti-robot du formulaire public")

Rel_R(tc, cpi, "Qualifie, ajoute, convertit")
Rel_R(enc, cpi, "Pilote, administre, encaisse")
Rel_R(pub, cpi, "Dépose une demande")
Rel_R(cpi, plat, "Lit les inscriptions")
Rel_R(cpi, brevo, "Envoie des e-mails")
Rel_R(cpi, turn, "Vérifie un jeton")
@enduml
