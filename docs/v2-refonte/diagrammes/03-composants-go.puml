@startuml 03-composants-go
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_LEFT_RIGHT()
title Niveau 3 : composants de apps/go. Comment le code est rangé.

Container_Boundary(go, "apps/go") {
  Component(server, "server.ts", "Node", "Démarre Next, le WebSocket de présence, les 7 crons")
  Component(pages, "app/(panel)/[projet]", "Next.js pages", "Un seul arbre d'écrans, projet en paramètre")
  Component(api, "app/api/v1", "Route handlers", "Une route par geste, validation zod")
  Component(domaines, "domaines/", "TypeScript", "Règles métier : représentants, prospects, qualification, conversion, ouvertures, campagnes, banque, visites, notifications, imports, exports, admin, sync")
  Component(auth, "lib/auth", "Better Auth", "users, account, session, JWT")
  Component(db, "lib/db", "Drizzle", "Schéma, SQL brut des analytics")
  Component(roles, "lib/roles", "Table de garde", "Rôle par route, source du test matrice")
}

Container(schema, "packages/schema", "zod", "Une définition par entité, partagée avec le mobile")
ContainerDb(pg, "Postgres 18")

Rel_R(server, pages, "Sert")
Rel_R(server, api, "Sert")
Rel_R(pages, domaines, "Appelle")
Rel_R(api, domaines, "Appelle")
Rel_R(api, roles, "Vérifie")
Rel_R(domaines, db, "Lit, écrit")
Rel_R(domaines, auth, "Session")
Rel_D(domaines, schema, "Valide avec")
Rel_R(db, pg, "SQL")
@enduml
