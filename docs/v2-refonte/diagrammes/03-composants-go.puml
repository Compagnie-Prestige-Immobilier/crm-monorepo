@startuml 03-composants-go
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_LEFT_RIGHT()
title Niveau 3 : composants de apps/go. Un binaire, un package, vingt fichiers.

Container_Boundary(go, "apps/go") {
  Component(main, "main.go, middleware.go, errors.go, cache.go", "net/http, embed, gocron, slog", "Mux, SPA embarquée, 7 crons, SSE, session, garde, Origin, limiteurs, RFC 9457, cache à version de groupe")
  Component(auth, "auth.go, roles.go", "argon2id", "Sessions dans refresh_tokens, cookie __Host-, table rôle x route avec assertions")
  Component(chues, "representants.go, prospects.go, qualification.go, campagnes.go, analytics.go", "huma", "CHUES et Grand Public : fiches, tentatives, ouvertures, rappels, notes vocales, présence, lots, chiffres")
  Component(autres, "banque.go, accueil.go, admin.go, referentiels.go, notifications.go, brevo.go, imports.go, exports.go, formulaire_public.go", "huma", "Banque, Accueil, Admin, référentiels, notifications, imports à bail, exports excelize/maroto, formulaire public")
  Component(sql, "sql/", "sqlc, goose", "schema.sql de référence, queries/ par domaine, migrations/")
  Component(web, "web/", "Vite, React 19, TanStack Router et Query, openapi-fetch", "Panneau ; dist/ embarqué dans le binaire")
}

ContainerDb(pg, "Postgres 18")

Rel_R(main, chues, "Monte")
Rel_R(main, autres, "Monte")
Rel_R(main, web, "Sert dist/")
Rel_R(chues, auth, "Session, garde")
Rel_R(autres, auth, "Session, garde")
Rel_R(chues, sql, "Appelle")
Rel_R(autres, sql, "Appelle")
Rel_D(web, chues, "Types OpenAPI produits au build")
Rel_R(sql, pg, "pgx")
@enduml
