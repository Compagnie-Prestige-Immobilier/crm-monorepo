@startuml 02-conteneurs
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_LEFT_RIGHT()
title Niveau 2 : conteneurs. Les deux briques logicielles de la v2.

Person(tc, "Téléconseiller", "Téléphone, navigateur")
Person(enc, "Encadrement", "Poste, navigateur")

System_Boundary(cpi, "CPI GO v2") {
  Container(go, "apps/go", "Go 1.27, net/http, huma, pgx, sqlc ; SPA React embarquée", "Panneau, API, 7 crons, SSE, cache mémoire, notes vocales")
  ContainerDb(pg, "Postgres 18", "", "Données métier, sessions")
}

Rel_R(tc, go, "HTTPS, cookie de session")
Rel_R(enc, go, "HTTPS, cookie de session")
Rel_R(go, pg, "pgx")
@enduml
